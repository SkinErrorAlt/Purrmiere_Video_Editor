{
 "id": "motion_tile",
 "label": "Motion Tile",
 "category": "Transform",
 "version": 1,
 "blurb": "Tiles the picture across the frame, with optional mirroring so the joins do not show. Scroll speed runs the offset on its own, in tiles per second towards the Scrolls towards angle (0 is up, 90 is right), so the wall of tiles drifts with no keyframes.",
 "params": [
  {"key": "tiles", "label": "Tiles across", "type": "float", "min": 1.0, "max": 32.0, "step": 0.5, "default": 3.0},
  {"key": "offset", "label": "Offset", "type": "vec2", "default": [0.0, 0.0]},
  {"key": "mirror", "label": "Mirror every other one", "type": "bool", "default": true},
  {"key": "keep_aspect", "label": "Square tiles", "type": "bool", "default": true},
  {"key": "speed", "label": "Scroll speed", "type": "float", "min": 0.0, "max": 4.0, "step": 0.01, "default": 0.0, "unit": " tiles/s"},
  {"key": "scroll_angle", "label": "Scrolls towards", "type": "float", "min": -180.0, "max": 180.0, "step": 0.5, "default": 90.0, "unit": " deg"}
 ],
 "passes": "single"
}
