 "params": [
  {"key": "angle", "label": "Angle (0 grades the top)", "type": "float", "min": -180.0, "max": 180.0, "step": 0.5, "default": 0.0, "unit": " deg"},
  {"key": "position", "label": "Reaches down to", "type": "float", "min": 0.0, "max": 1.0, "step": 0.005, "default": 0.45},
  {"key": "softness", "label": "Softness", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.35},
  {"key": "exposure", "label": "Exposure", "type": "float", "min": -4.0, "max": 4.0, "step": 0.01, "default": -1.0, "unit": " stops"},
  {"key": "colour", "label": "Colour", "type": "color", "default": [0.45, 0.65, 1.0, 1.0]},
  {"key": "colour_amount", "label": "Colour amount", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.3},
  {"key": "saturation", "label": "Saturation", "type": "float", "min": 0.0, "max": 2.0, "step": 0.01, "default": 1.1},
  {"key": "contrast", "label": "Contrast", "type": "float", "min": -1.0, "max": 1.0, "step": 0.01, "default": 0.1},
  {"key": "show_mask", "label": "Show the graded area", "type": "bool", "default": false}
 ],
 "handles": [{"kind": "angle", "key": "angle", "zero": "up", "turn": "cw"}],
