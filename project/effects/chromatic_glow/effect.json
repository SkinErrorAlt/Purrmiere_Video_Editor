{
 "id": "chromatic_glow",
 "label": "Chromatic Glow",
 "category": "Light & Shadow",
 "tags": ["light"],
 "version": 1,
 "blurb": "A wide glow whose halo splits into the spectrum: the core stays white hot, then a pale gold band, then a red rim reaching furthest (negative Dispersion turns it round so blue reaches furthest). The falloff is exponential, so the tail runs long without washing out the core. At zero Dispersion the halo is neutral and matches the plain Glow on the same settings, except that clipped whites are given extra reach. The glow spreads onto clear parts of the layer too, so it works on titles and logos.",
 "params": [
  {"key": "threshold", "label": "Threshold", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.45},
  {"key": "radius", "label": "Radius", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.7},
  {"key": "intensity", "label": "Intensity", "type": "float", "min": 0, "max": 4, "step": 0.01, "default": 1.3},
  {"key": "dispersion", "label": "Dispersion", "type": "float", "min": -1, "max": 1, "step": 0.01, "default": 0.6},
  {"key": "falloff", "label": "Falloff (tight to long)", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.7},
  {"key": "saturation", "label": "Fringe saturation", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.5},
  {"key": "tint", "label": "Tint", "type": "color", "default": [1, 1, 1, 1]},
  {"key": "glow_only", "label": "Glow only", "type": "bool", "default": false}
 ],
 "passes": [
  {"shader": "bright.gdshader"},
  {"shader": "down.gdshader", "scale": 0.5},
  {"shader": "down.gdshader", "scale": 0.5},
  {"shader": "down.gdshader", "scale": 0.5},
  {"shader": "down.gdshader", "scale": 0.5},
  {"shader": "down.gdshader", "scale": 0.5},
  {"shader": "down.gdshader", "scale": 0.5},
  {"shader": "up.gdshader", "scale": 2.0, "inputs": {"level_tex": 5}, "set": {"tail": true, "level": 6}},
  {"shader": "up.gdshader", "scale": 2.0, "inputs": {"level_tex": 4}, "set": {"tail": true, "level": 5}},
  {"shader": "up.gdshader", "scale": 2.0, "inputs": {"level_tex": 3}, "set": {"level": 4}},
  {"shader": "up.gdshader", "scale": 2.0, "inputs": {"level_tex": 2}, "set": {"level": 3}},
  {"shader": "up.gdshader", "scale": 2.0, "inputs": {"level_tex": 1}, "set": {"level": 2}},
  {"shader": "up.gdshader", "scale": 2.0, "inputs": {"level_tex": 0}, "set": {"level": 1}},
  {"shader": "mix.gdshader"}
 ]
}
