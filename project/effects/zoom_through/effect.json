{
 "id": "zoom_through",
 "label": "Zoom Through",
 "category": "Transition",
 "version": 1,
 "blurb": "The seamless zoom: put it on both clips of a cut and the first one rushes into the frame with heavy zoom blur while the next one keeps the same rush going as it lands, so the cut hides inside the blur. Zoom out runs it backwards; Spin adds a turn. The picture repeats round the edges, so no gap shows. Use Progress to key it by hand.",
 "params": [
  {"key": "when", "label": "When", "type": "enum", "choices": ["In at the start and out at the end", "In at the start", "Out at the end", "By Progress"], "default": 0},
  {"key": "duration", "label": "Zoom length", "type": "float", "min": 0.05, "max": 3.0, "step": 0.01, "default": 0.4, "unit": " s"},
  {"key": "progress", "label": "Progress", "type": "float", "min": 0.0, "max": 1.0, "step": 0.005, "default": 0.0},
  {"key": "style", "label": "Zoom", "type": "enum", "choices": ["Zoom in", "Zoom out"], "default": 0},
  {"key": "centre", "label": "Zoom towards", "type": "vec2", "default": [0.5, 0.5]},
  {"key": "strength", "label": "How far", "type": "float", "min": 0.2, "max": 8.0, "step": 0.05, "default": 3.0},
  {"key": "turn", "label": "Spin", "type": "float", "min": -360.0, "max": 360.0, "step": 1.0, "default": 0.0, "unit": " deg"},
  {"key": "blur", "label": "Motion blur", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.8},
  {"key": "edges", "label": "Edges", "type": "enum", "choices": ["Mirror", "Repeat"], "default": 0}
 ],
 "handles": [{"kind": "point", "key": "centre"}],
 "passes": [
  {"shader": "zoom.gdshader", "set": {"stage": 0}},
  {"shader": "zoom.gdshader", "set": {"stage": 1}}
 ]
}
