{
 "id": "matte_cleanup",
 "label": "Matte Cleanup",
 "category": "Keying",
 "version": 1,
 "blurb": "Tidies a key without moving its outline: Clip black and Clip white snap the nearly clear and nearly solid parts of the matte to fully clear and fully solid, Fill holes closes the small see through spots inside the subject with the colour around them, and Remove specks then takes away stray dots left on the screen. Matte Choker moves the whole edge; this leaves the edge where it is.",
 "params": [
  {"key": "clip_black", "label": "Clip black", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.1},
  {"key": "clip_white", "label": "Clip white", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.9},
  {"key": "specks", "label": "Remove specks up to", "type": "float", "min": 0.0, "max": 20.0, "step": 0.1, "default": 2.0, "unit": " px"},
  {"key": "holes", "label": "Fill holes up to", "type": "float", "min": 0.0, "max": 20.0, "step": 0.1, "default": 3.0, "unit": " px"},
  {"key": "show_matte", "label": "Show the matte", "type": "bool", "default": false}
 ],
 "passes": [
  {"shader": "levels.gdshader"},
  {"shader": "minmax.gdshader", "set": {"direction": [1.0, 0.0], "use_max": true}, "map": {"span": "holes"}, "when": {"param": "holes", "gt": 0}},
  {"shader": "minmax.gdshader", "set": {"direction": [0.0, 1.0], "use_max": true}, "map": {"span": "holes"}, "when": {"param": "holes", "gt": 0}},
  {"shader": "minmax.gdshader", "set": {"direction": [1.0, 0.0], "use_max": false}, "map": {"span": "holes"}, "when": {"param": "holes", "gt": 0}},
  {"shader": "minmax.gdshader", "set": {"direction": [0.0, 1.0], "use_max": false}, "map": {"span": "holes"}, "when": {"param": "holes", "gt": 0}},
  {"shader": "minmax.gdshader", "set": {"direction": [1.0, 0.0], "use_max": false}, "map": {"span": "specks"}, "when": {"param": "specks", "gt": 0}},
  {"shader": "minmax.gdshader", "set": {"direction": [0.0, 1.0], "use_max": false}, "map": {"span": "specks"}, "when": {"param": "specks", "gt": 0}},
  {"shader": "minmax.gdshader", "set": {"direction": [1.0, 0.0], "use_max": true}, "map": {"span": "specks"}, "when": {"param": "specks", "gt": 0}},
  {"shader": "minmax.gdshader", "set": {"direction": [0.0, 1.0], "use_max": true}, "map": {"span": "specks"}, "when": {"param": "specks", "gt": 0}},
  {"shader": "combine.gdshader"}
 ]
}
