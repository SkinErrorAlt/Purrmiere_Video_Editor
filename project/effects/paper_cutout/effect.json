{
 "id": "paper_cutout",
 "label": "Paper Cutout",
 "category": "Stylize",
 "tags": ["look"],
 "version": 1,
 "blurb": "Rebuilds the picture from a few flat layers of paper with smooth cut edges, each casting a small shadow on the layer below.",
 "params": [
  {"key": "levels", "label": "Layers", "type": "int", "min": 2, "max": 12, "step": 1, "default": 5},
  {"key": "edge_smoothness", "label": "Edge smoothness", "type": "float", "min": 0.0, "max": 40.0, "step": 0.1, "default": 6.0, "unit": " px"},
  {"key": "shadow", "label": "Shadow", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.5},
  {"key": "shadow_distance", "label": "Shadow length", "type": "float", "min": 0.0, "max": 30.0, "step": 0.1, "default": 5.0, "unit": " px"},
  {"key": "shadow_angle", "label": "Shadow direction", "type": "float", "min": -180.0, "max": 180.0, "step": 1.0, "default": -45.0, "unit": " deg"},
  {"key": "stack", "label": "Stacking", "type": "enum", "choices": ["Light on top", "Dark on top"], "default": 0},
  {"key": "saturation", "label": "Saturation", "type": "float", "min": 0.0, "max": 2.0, "step": 0.01, "default": 1.0},
  {"key": "paper_texture", "label": "Paper texture", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.3}
 ],
 "handles": [{"kind": "angle", "key": "shadow_angle", "zero": "right", "turn": "ccw", "length": "shadow_distance"}],
 "passes": [
  {"shader": "res://effects/blur_gaussian/gauss.gdshader", "set": {"direction": [1.0, 0.0], "kernel": 0, "dims": 0, "edge": true}, "map": {"radius": "edge_smoothness"}},
  {"shader": "res://effects/blur_gaussian/gauss.gdshader", "set": {"direction": [0.0, 1.0], "kernel": 0, "dims": 0, "edge": true}, "map": {"radius": "edge_smoothness"}},
  {"shader": "cutout.gdshader"}
 ]
}
