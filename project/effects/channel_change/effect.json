  {"key": "progress", "label": "Progress", "type": "float", "min": 0.0, "max": 1.0, "step": 0.005, "default": 0.0},
  {"key": "static_amount", "label": "Static", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 1.0},
  {"key": "roll", "label": "Roll", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.6},
  {"key": "tear", "label": "Tearing", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.5},
  {"key": "colour_noise", "label": "Colour in the static", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.25}
 ],
