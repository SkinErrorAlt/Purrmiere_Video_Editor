{
 "id": "audio_pulse_scale",
 "label": "Pulse Scale",
 "category": "Audio Reactive",
 "tags": [
  "audio",
  "music",
  "beat",
  "reactive",
  "visualiser"
 ],
 "version": 1,
 "blurb": "The picture punches in with the sound: it grows by Punch at the loudest point and settles back as the sound falls away. Set to Beat it thumps on each hit. Drop a clip from the timeline, or a file from the bin or the Source monitor, on its Sound well.",
 "params": [
  {
   "key": "punch",
   "label": "Punch",
   "type": "float",
   "min": 0,
   "max": 100,
   "step": 0.1,
   "default": 12,
   "unit": " %"
  },
  {
   "key": "anchor",
   "label": "Centre",
   "type": "vec2",
   "default": [
    0.5,
    0.5
   ]
  },
  {
   "key": "edges",
   "label": "Edges",
   "type": "enum",
   "choices": [
    "Transparent",
    "Mirror",
    "Repeat",
    "Stretch"
   ],
   "default": 1
  }
 ],
 "passes": [
  {
   "shader": "res://effects/audio_pulse_scale/motion.gdshader"
  }
 ],
 "reactive": {
  "defaults": {
   "snd_mode": 1,
   "snd_band": 1
  },
  "drive": {
   "zoom": {
    "rest": 0,
    "peak": "punch",
    "mul": 0.01,
    "add": 1.0
   }
  }
 },
 "handles": [
  {
   "kind": "point",
   "key": "anchor"
  }
 ]
}
