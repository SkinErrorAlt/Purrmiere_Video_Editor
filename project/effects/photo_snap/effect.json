{
 "id": "photo_snap",
 "label": "Photo Snap",
 "category": "Stylize",
 "tags": ["look"],
 "version": 1,
 "blurb": "A camera flash, then the moment shrinks into a printed photo with a white border, tilted, with a shadow, over a blurred and darkened copy of the scene (or over the track below). Put it on a freeze frame for the classic \"that was the moment\" pause.",
 "params": [
  {"key": "starts_at", "label": "Snap at", "type": "float", "min": 0.0, "max": 600.0, "step": 0.01, "default": 0.0, "unit": " s"},
  {"key": "move_time", "label": "Settle over", "type": "float", "min": 0.05, "max": 3.0, "step": 0.01, "default": 0.4, "unit": " s"},
  {"key": "flash", "label": "Flash", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.8},
  {"key": "size", "label": "Photo size", "type": "float", "min": 0.2, "max": 1.0, "step": 0.01, "default": 0.72},
  {"key": "tilt", "label": "Tilt", "type": "float", "min": -45.0, "max": 45.0, "step": 0.1, "default": -5.0, "unit": " deg"},
  {"key": "photo_at", "label": "Photo at", "type": "vec2", "default": [0.5, 0.47]},
  {"key": "style", "label": "Border", "type": "enum", "choices": ["Even", "Instant photo", "None"], "default": 1},
  {"key": "border", "label": "Border width", "type": "float", "min": 0.0, "max": 120.0, "step": 0.5, "default": 22.0, "unit": " px"},
  {"key": "paper_colour", "label": "Border colour", "type": "color", "default": [0.97, 0.96, 0.93, 1.0]},
  {"key": "behind", "label": "Behind the photo", "type": "enum", "choices": ["Blurred scene", "See through"], "default": 0},
  {"key": "dim", "label": "Darken behind", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.45},
  {"key": "shadow", "label": "Shadow", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.6}
 ],
 "handles": [{"kind": "point", "key": "photo_at"}, {"kind": "angle", "key": "tilt", "about": "photo_at"}, {"kind": "ring", "key": "size", "about": "photo_at", "unit": "h", "scale": 2.0, "frame": true, "rotate": "tilt", "shape": "box", "knob": "corner"}],
 "passes": [
  {"shader": "res://effects/glow/down13.gdshader", "scale": 0.5},
  {"shader": "res://effects/glow/down13.gdshader", "scale": 0.5},
  {"shader": "res://effects/glow/down13.gdshader", "scale": 0.5},
  {"shader": "snap.gdshader", "scale": 8.0}
 ]
}
