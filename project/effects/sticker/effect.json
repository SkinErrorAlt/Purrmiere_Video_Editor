{
 "id": "sticker",
 "label": "Sticker",
 "category": "Light & Shadow",
 "tags": ["graphic"],
 "version": 1,
 "blurb": "Turns a cut out person, a logo or an emoji into a sticker: a thick border cut round it with the tight corners and gaps rounded off, the way scissors would, a soft shadow under the card and a faint sheen. Round off sets how much the border smooths the outline. Multi Outline follows every notch of the shape; this cuts one smooth card round it.",
 "params": [
  {"key": "border", "label": "Border width", "type": "float", "min": 0.0, "max": 80.0, "step": 0.1, "default": 14.0, "unit": " px"},
  {"key": "colour", "label": "Border colour", "type": "color", "default": [1.0, 1.0, 1.0, 1.0]},
  {"key": "smooth", "label": "Round off", "type": "float", "min": 0.0, "max": 60.0, "step": 0.1, "default": 10.0, "unit": " px"},
  {"key": "shadow", "label": "Shadow", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.45},
  {"key": "shadow_angle", "label": "Shadow direction", "type": "float", "min": -180.0, "max": 180.0, "step": 1.0, "default": 150.0, "unit": "deg"},
  {"key": "shadow_distance", "label": "Shadow distance", "type": "float", "min": 0.0, "max": 100.0, "step": 0.1, "default": 8.0, "unit": " px"},
  {"key": "shadow_softness", "label": "Shadow softness", "type": "float", "min": 0.0, "max": 60.0, "step": 0.1, "default": 10.0, "unit": " px"},
  {"key": "sheen", "label": "Sheen", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.15}
 ],
 "handles": [{"kind": "angle", "key": "shadow_angle", "length": "shadow_distance"}],
 "passes": [
  {"shader": "res://effects/feather_matte/dist_across.gdshader", "map": {"reach_a": "border", "reach_b": "smooth"}},
  {"shader": "res://effects/feather_matte/dist_down.gdshader", "map": {"reach_a": "border", "reach_b": "smooth"}},
  {"shader": "mask.gdshader"},
  {"shader": "res://effects/blur_gaussian/gauss.gdshader", "set": {"direction": [1.0, 0.0], "kernel": 0, "dims": 0, "edge": false}, "map": {"radius": "smooth"}, "when": {"param": "smooth", "gt": 0}},
  {"shader": "res://effects/blur_gaussian/gauss.gdshader", "set": {"direction": [0.0, 1.0], "kernel": 0, "dims": 0, "edge": false}, "map": {"radius": "smooth"}, "when": {"param": "smooth", "gt": 0}},
  {"shader": "combine.gdshader"}
 ]
}
