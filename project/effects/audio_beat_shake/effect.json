{
 "id": "audio_beat_shake",
 "label": "Sound Shake",
 "category": "Audio Reactive",
 "tags": [
  "audio",
  "music",
  "beat",
  "reactive",
  "visualiser"
 ],
 "version": 1,
 "blurb": "Camera Shake that only moves while the sound is loud: the wobble, turn and zoom grow with the sound and stop in the quiet parts. Drop a clip from the timeline, or a file from the bin or the Source monitor, on its Sound well.",
 "params": [
  {
   "key": "shake",
   "label": "Shake",
   "type": "float",
   "min": 0,
   "max": 200,
   "step": 0.5,
   "default": 30,
   "unit": " px"
  },
  {
   "key": "turn",
   "label": "Turn",
   "type": "float",
   "min": 0,
   "max": 30,
   "step": 0.1,
   "default": 2,
   "unit": " deg"
  },
  {
   "key": "zoom_amt",
   "label": "Zoom",
   "type": "float",
   "min": 0,
   "max": 50,
   "step": 0.1,
   "default": 4,
   "unit": " %"
  },
  {
   "key": "frequency",
   "label": "Frequency",
   "type": "float",
   "min": 0.1,
   "max": 30,
   "step": 0.1,
   "default": 8,
   "unit": " Hz"
  },
  {
   "key": "octaves",
   "label": "Roughness",
   "type": "int",
   "min": 1,
   "max": 4,
   "step": 1,
   "default": 2
  },
  {
   "key": "seed",
   "label": "Seed",
   "type": "int",
   "min": 0,
   "max": 9999,
   "step": 1,
   "default": 0
  },
  {
   "key": "edges",
   "label": "Edges",
   "type": "enum",
   "choices": [
    "Mirror",
    "Repeat",
    "Zoom in to hide",
    "Transparent"
   ],
   "default": 2
  },
  {
   "key": "motion_blur",
   "label": "Motion blur",
   "type": "float",
   "min": 0,
   "max": 1,
   "step": 0.01,
   "default": 0.5
  }
 ],
 "passes": [
  {
   "shader": "res://effects/camera_shake/shake.gdshader"
  }
 ],
 "reactive": {
  "defaults": {
   "snd_mode": 1,
   "snd_band": 1
  },
  "drive": {
   "amplitude": {
    "rest": 0,
    "peak": "shake"
   },
   "rotation": {
    "rest": 0,
    "peak": "turn"
   },
   "zoom": {
    "rest": 0,
    "peak": "zoom_amt"
   }
  }
 }
}
