{
 "id": "motion_heat",
 "label": "Motion Heat Map",
 "category": "Time",
 "tags": ["look"],
 "version": 1,
 "blurb": "Shows where things have been moving, as heat. Every bit of movement over the last couple of seconds warms that part of the picture, so busy paths glow white hot, places people pass now and then glow red and purple, and the still world cools to dark grey. A crossing reveals its walking lines, a dancer burns a bright cloud of her own steps, traffic draws hot lanes. Memory sets whether old movement counts as much as new.",
 "history": {"max": 62, "reach": ["span"], "seconds": ["span"]},
 "params": [
  {"key": "span", "label": "Remember for", "type": "float", "min": 0.2, "max": 2.0, "step": 0.01, "default": 2.0, "unit": " s"},
  {"key": "samples", "label": "Moments counted", "type": "int", "min": 4, "max": 40, "step": 1, "default": 24},
  {"key": "sensitivity", "label": "Sensitivity", "type": "float", "min": 0.1, "max": 10.0, "step": 0.05, "default": 2.5},
  {"key": "threshold", "label": "Ignore grain", "type": "float", "min": 0.0, "max": 0.3, "step": 0.002, "default": 0.03},
  {"key": "memory", "label": "Old movement counts", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.5},
  {"key": "palette", "label": "Colours", "type": "enum", "choices": ["Thermal", "Ice", "One colour"], "default": 0},
  {"key": "colour", "label": "Heat colour", "type": "color", "default": [1.0, 0.35, 0.1, 1.0]},
  {"key": "show", "label": "Show", "type": "enum", "choices": ["Heat over the picture", "Heat only"], "default": 0},
  {"key": "picture", "label": "Picture brightness", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.55},
  {"key": "opacity", "label": "Heat strength", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.9}
 ],
 "passes": [
  {"shader": "heat.gdshader", "scale": 0.5},
  {"shader": "blur.gdshader", "scale": 0.5, "set": {"spread": 1.0}},
  {"shader": "blur.gdshader", "scale": 1.0, "set": {"spread": 1.5}},
  {"shader": "compose.gdshader", "scale": 4.0}
 ]
}
