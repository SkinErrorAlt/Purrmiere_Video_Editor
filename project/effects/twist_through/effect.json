  {"key": "progress", "label": "Progress", "type": "float", "min": 0.0, "max": 1.0, "step": 0.005, "default": 0.0},
  {"key": "centre", "label": "Centre", "type": "vec2", "default": [0.5, 0.5]},
  {"key": "turns", "label": "Twist", "type": "float", "min": -3.0, "max": 3.0, "step": 0.05, "default": 1.0, "unit": " turns"},
  {"key": "size", "label": "Size", "type": "float", "min": 0.1, "max": 2.0, "step": 0.01, "default": 0.7},
  {"key": "zoom", "label": "Rush in", "type": "float", "min": 0.0, "max": 3.0, "step": 0.05, "default": 1.0},
  {"key": "blur", "label": "Motion blur", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.7},
