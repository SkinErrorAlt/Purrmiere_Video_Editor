{
 "id": "colorama",
 "label": "Colorama",
 "category": "Stylize",
 "version": 1,
 "blurb": "Runs the picture's lightness, hue or one channel through a looping palette. Move the phase, or give it a speed, to make the colours cycle.",
 "params": [
  {"key": "input_from", "label": "Take from", "type": "enum", "choices": ["Lightness", "Hue", "Saturation", "Red", "Green", "Blue"], "default": 0},
  {"key": "palette", "label": "Palette", "type": "enum", "choices": ["Rainbow", "Fire", "Ice", "Neon", "Custom three colours"], "default": 0},
  {"key": "cycles", "label": "Cycles", "type": "float", "min": 0.1, "max": 10.0, "step": 0.01, "default": 1.0},
  {"key": "phase", "label": "Phase", "type": "float", "min": 0.0, "max": 1.0, "step": 0.001, "default": 0.0},
  {"key": "speed", "label": "Cycle speed", "type": "float", "min": -5.0, "max": 5.0, "step": 0.01, "default": 0.0, "unit": " per s"},
  {"key": "keep_lightness", "label": "Keep the lightness", "type": "bool", "default": false},
  {"key": "blend", "label": "Blend with the picture", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.0},
  {"key": "colour_1", "label": "Custom colour 1", "type": "color", "default": [0.1, 0.1, 0.5, 1.0]},
  {"key": "colour_2", "label": "Custom colour 2", "type": "color", "default": [0.9, 0.2, 0.4, 1.0]},
  {"key": "colour_3", "label": "Custom colour 3", "type": "color", "default": [1.0, 0.85, 0.3, 1.0]}
 ],
