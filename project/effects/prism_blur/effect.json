{
 "id": "prism_blur",
 "label": "Prism Blur",
 "category": "Blur & Sharpen",
 "version": 1,
 "blurb": "Blurs the picture and splits the blur into the colours of the spectrum, as light does through a prism, so edges pick up a rainbow fringe with red on one side and blue on the other. Along an angle splits every part the same way; Out from the centre splits more towards the edges of the frame, like a cheap lens.",
 "params": [
  {"key": "blur", "label": "Blur", "type": "float", "min": 0.0, "max": 60.0, "step": 0.1, "default": 3.0, "unit": " px"},
  {"key": "spread", "label": "Prism spread", "type": "float", "min": 0.0, "max": 100.0, "step": 0.1, "default": 14.0, "unit": " px"},
  {"key": "mode", "label": "Split", "type": "enum", "choices": ["Along an angle", "Out from the centre"], "default": 1},
  {"key": "angle", "label": "Angle", "type": "float", "min": -180.0, "max": 180.0, "step": 0.5, "default": 0.0, "unit": " deg"},
  {"key": "centre", "label": "Centre", "type": "vec2", "default": [0.5, 0.5]}
 ],
 "handles": [{"kind": "point", "key": "centre"}, {"kind": "angle", "key": "angle", "about": "centre", "zero": "right", "turn": "cw"}],
 "passes": [
  {"shader": "res://effects/blur_gaussian/gauss.gdshader", "set": {"direction": [1.0, 0.0]}, "map": {"radius": "blur"}},
  {"shader": "res://effects/blur_gaussian/gauss.gdshader", "set": {"direction": [0.0, 1.0]}, "map": {"radius": "blur"}},
  {"shader": "prism.gdshader"}
 ]
}
