{
 "id": "snd_treble_glint",
 "label": "Treble Glint",
 "category": "Audio Reactive",
 "tags": [
  "audio",
  "reactive",
  "light"
 ],
 "version": 1,
 "blurb": "High sounds make the light sparkle. Cymbals, hi-hats, breaking glass, sparks and sharp clicks flare the brightest points of the shot into star glints that twinkle and fade, while bass, booms and voices leave the highlights calm. It reads the top of the spectrum and the sharpness of each hit, so a crash makes the lamps burst and a kick drum does not.",
 "params": [
  {
   "key": "threshold",
   "label": "Highlights from",
   "type": "float",
   "min": 0.0,
   "max": 1.0,
   "step": 0.01,
   "default": 0.55
  },
  {
   "key": "length_px",
   "label": "Glint length",
   "type": "float",
   "min": 4.0,
   "max": 300.0,
   "step": 1.0,
   "default": 110.0,
   "unit": " px"
  },
  {
   "key": "points",
   "label": "Points",
   "type": "enum",
   "choices": [
    "4",
    "6",
    "8"
   ],
   "default": 1
  },
  {
   "key": "rotation",
   "label": "Turn",
   "type": "float",
   "min": -180.0,
   "max": 180.0,
   "step": 0.5,
   "default": 15.0,
   "unit": " deg"
  },
  {
   "key": "strength",
   "label": "Strength",
   "type": "float",
   "min": 0.0,
   "max": 3.0,
   "step": 0.01,
   "default": 1.5
  },
  {
   "key": "colour",
   "label": "Glint colour",
   "type": "color",
   "default": [
    0.92,
    0.96,
    1.0,
    1.0
   ]
  },
  {
   "key": "twinkle",
   "label": "Twinkle",
   "type": "float",
   "min": 0.0,
   "max": 1.0,
   "step": 0.01,
   "default": 0.6
  }
 ],
 "passes": [
  {
   "shader": "bright.gdshader",
   "scale": 0.5
  },
  {
   "shader": "star.gdshader"
  },
  {
   "shader": "comp.gdshader",
   "scale": 2.0
  }
 ],
 "reactive": {
  "listen": true,
  "defaults": {
   "snd_threshold": 0.0
  }
 }
}