{
 "id": "sharpen_clarity",
 "label": "Clarity",
 "category": "Blur & Sharpen",
 "version": 1,
 "blurb": "Local contrast on brightness over a wide radius.",
 "params": [
  {"key": "amount", "label": "Clarity", "type": "float", "min": -1, "max": 3, "step": 0.01, "default": 0.5},
  {"key": "radius", "label": "Radius", "type": "float", "min": 1, "max": 120, "step": 0.5, "default": 24}
 ],
 "passes": [
  {"shader": "res://effects/blur_gaussian/gauss.gdshader", "set": {"direction": [1.0, 0.0], "kernel": 0, "dims": 0, "edge": true}},
  {"shader": "res://effects/blur_gaussian/gauss.gdshader", "set": {"direction": [0.0, 1.0], "kernel": 0, "dims": 0, "edge": true}},
  {"shader": "res://effects/sharpen/sharpen_mix.gdshader", "set": {"threshold": 0.0, "luma_only": true}}
 ]
}
