{
 "id": "audio_opacity_flicker",
 "label": "Opacity Flicker",
 "category": "Audio Reactive",
 "tags": [
  "audio",
  "music",
  "beat",
  "reactive",
  "visualiser"
 ],
 "version": 1,
 "blurb": "The picture flickers towards Opacity when loud on each hit and is solid again in between. Swap the two values to fade it in the quiet parts instead. Drop a clip from the timeline, or a file from the bin or the Source monitor, on its Sound well.",
 "params": [
  {
   "key": "quiet_opacity",
   "label": "Opacity when quiet",
   "type": "float",
   "min": 0,
   "max": 1,
   "step": 0.01,
   "default": 1
  },
  {
   "key": "loud_opacity",
   "label": "Opacity when loud",
   "type": "float",
   "min": 0,
   "max": 1,
   "step": 0.01,
   "default": 0.3
  }
 ],
 "passes": [
  {
   "shader": "res://effects/alpha_adjust/effect.gdshader"
  }
 ],
 "reactive": {
  "defaults": {
   "snd_mode": 1,
   "snd_decay": 150
  },
  "drive": {
   "opacity": {
    "rest": "quiet_opacity",
    "peak": "loud_opacity"
   }
  }
 }
}
