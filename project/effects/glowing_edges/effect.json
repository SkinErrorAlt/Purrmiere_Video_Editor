  {"key": "edge_brightness", "label": "Edge brightness", "type": "float", "min": 0, "max": 20, "step": 0.1, "default": 6},
  {"key": "smoothness", "label": "Smoothness", "type": "float", "min": 1, "max": 15, "step": 0.1, "default": 5}
 ],
 "passes": [
  {"shader": "soften.gdshader", "set": {"direction": [1, 0]}},
  {"shader": "soften.gdshader", "set": {"direction": [0, 1]}},
  {"shader": "edges.gdshader"}
 ]
}
