{
 "id": "stirred_smoke",
 "label": "Stirred Smoke",
 "category": "Stylize",
 "tags": [
  "look"
 ],
 "version": 1,
 "blurb": "The picture gives off smoke, and its own movement stirs the air. Bright parts smoulder, or anything that moves sheds a vapour of its own colour, or dark parts bleed downwards like ink dropped in water. The smoke rises, curls and thins out over the last second or so of the clip, and every movement in the shot whips up swirls in it: a hand waved through it leaves eddies, a passing car drags it along, a dancer spins it into curls. It is worked out again from the clip's own recent frames for every frame, so it looks the same playing, paused, stepped or exported.",
 "history": {
  "max": 48,
  "reach": [
   "memory"
  ],
  "seconds": [
   "memory"
  ]
 },
 "params": [
  {
   "key": "source",
   "label": "Smoke comes from",
   "type": "enum",
   "choices": [
    "Bright parts",
    "Things that move",
    "Dark parts, as ink"
   ],
   "default": 0
  },
  {
   "key": "memory",
   "label": "Lingers for",
