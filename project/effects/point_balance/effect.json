  {"key": "grey_point", "label": "Grey point", "type": "vec2", "default": [0.5, 0.5]},
  {"key": "grey_target", "label": "Grey point becomes", "type": "color", "default": [0.5, 0.5, 0.5, 1.0]},
  {"key": "black_on", "label": "Use the black point", "type": "bool", "default": false},
  {"key": "black_point", "label": "Black point", "type": "vec2", "default": [0.1, 0.9]},
  {"key": "white_on", "label": "Use the white point", "type": "bool", "default": false},
  {"key": "white_point", "label": "White point", "type": "vec2", "default": [0.9, 0.1]},
  {"key": "sample_size", "label": "Sample size", "type": "float", "min": 1.0, "max": 40.0, "step": 0.5, "default": 8.0, "unit": " px"},
  {"key": "amount", "label": "Amount", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 1.0},
  {"key": "mark", "label": "Mark the points", "type": "bool", "default": false}
 ],
