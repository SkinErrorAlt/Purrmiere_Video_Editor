{
 "id": "tile_flip",
 "label": "Tile Flip",
 "category": "Transition",
 "version": 1,
 "blurb": "The picture breaks into tiles that flip over one after another in a wave, from a side, out from a point or at random, and the next clip's tiles flip in the same way. One row of tiles gives turning blinds. Put it on both clips of a cut, or use Progress to key it by hand; the track below shows between the tiles.",
 "params": [
  {"key": "when", "label": "When", "type": "enum", "choices": ["In at the start and out at the end", "In at the start", "Out at the end", "By Progress"], "default": 0},
  {"key": "duration", "label": "Length", "type": "float", "min": 0.1, "max": 3.0, "step": 0.01, "default": 0.8, "unit": " s"},
  {"key": "progress", "label": "Progress", "type": "float", "min": 0.0, "max": 1.0, "step": 0.005, "default": 0.0},
  {"key": "across", "label": "Tiles across", "type": "int", "min": 1, "max": 32, "step": 1, "default": 8},
  {"key": "down", "label": "Tiles down", "type": "int", "min": 1, "max": 24, "step": 1, "default": 5},
  {"key": "axis", "label": "Flip", "type": "enum", "choices": ["Sideways", "Over the top"], "default": 0},
  {"key": "order", "label": "Order", "type": "enum", "choices": ["From a side", "Out from a point", "At random"], "default": 0},
  {"key": "angle", "label": "Wave goes", "type": "float", "min": -180.0, "max": 180.0, "step": 1.0, "default": 90.0, "unit": " deg"},
  {"key": "centre", "label": "Starts at", "type": "vec2", "default": [0.5, 0.5]},
  {"key": "spread", "label": "One after another", "type": "float", "min": 0.0, "max": 0.9, "step": 0.01, "default": 0.6},
  {"key": "perspective", "label": "Depth", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.5},
  {"key": "shade", "label": "Shading", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.5},
  {"key": "seed", "label": "Seed", "type": "int", "min": 0, "max": 9999, "step": 1, "default": 0}
 ],
 "handles": [{"kind": "point", "key": "centre", "when": {"key": "order", "is": [1]}}, {"kind": "angle", "key": "angle", "zero": "up", "turn": "cw", "when": {"key": "order", "is": [0]}}],
 "passes": "single"
}
