  {"key": "height", "label": "Camera height", "type": "float", "min": 0.1, "max": 5.0, "step": 0.01, "default": 1.0},
  {"key": "tile_size", "label": "Tile size", "type": "float", "min": 0.05, "max": 8.0, "step": 0.01, "default": 2.0},
  {"key": "mirror", "label": "Mirror every other tile", "type": "bool", "default": false},
  {"key": "scroll", "label": "Scroll speed", "type": "float", "min": -10.0, "max": 10.0, "step": 0.01, "default": 0.0, "unit": " tiles/s"},
  {"key": "horizon", "label": "Horizon position", "type": "float", "min": 0.0, "max": 1.0, "step": 0.001, "default": 0.35},
