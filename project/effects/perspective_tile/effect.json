  {"shader": "res://effects/blur_gaussian/down.gdshader", "scale": 0.5},
  {"shader": "res://effects/blur_gaussian/down.gdshader", "scale": 0.5},
  {"shader": "res://effects/blur_gaussian/down.gdshader", "scale": 0.5},
  {"shader": "plane.gdshader", "scale": 32.0, "inputs": {"mip1": 0, "mip2": 1, "mip3": 2, "mip4": 3, "mip5": 4}}
