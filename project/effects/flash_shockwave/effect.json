{
 "id": "flash_shockwave",
 "label": "Flash Shockwave",
 "category": "Time",
 "tags": ["light"],
 "version": 1,
 "blurb": "Watches the footage for flashes, explosions, muzzle flashes and lights bursting on, and sends a pressure wave rolling out from exactly where each one went off. The wave bends the picture behind it like a lens of compressed air, splits colour on its leading edge and leaves the air shimmering with heat. A bigger flash sends a stronger wave. Nothing to place or key: every flash in the clip gets its own wave in the right spot.",
 "history": {"max": 62, "reach": ["wave_length", 1.12], "seconds": ["wave_length"]},
 "params": [
  {"key": "strength", "label": "Strength", "type": "float", "min": 0.0, "max": 2.0, "step": 0.01, "default": 1.3},
  {"key": "speed", "label": "Speed", "type": "float", "min": 0.2, "max": 3.0, "step": 0.01, "default": 1.1},
  {"key": "wave_length", "label": "Lasts", "type": "float", "min": 0.2, "max": 1.8, "step": 0.01, "default": 1.0, "unit": " s"},
  {"key": "ring_width", "label": "Ring width", "type": "float", "min": 0.01, "max": 0.3, "step": 0.005, "default": 0.07},
  {"key": "heat", "label": "Heat haze", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.5},
  {"key": "colour_split", "label": "Colour split", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.3},
  {"key": "sensitivity", "label": "Flash sensitivity", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.5}
 ],
 "passes": [
  {"shader": "res://effects/_events/thumbs.gdshader", "scale": 0.125},
  {"shader": "res://effects/_events/stats_flash.gdshader", "scale": 0.25},
  {"shader": "res://effects/_events/track_flash.gdshader", "scale": 1.0, "map": {"look_back": "wave_length"}},
  {"shader": "apply.gdshader", "scale": 32.0}
 ]
}
