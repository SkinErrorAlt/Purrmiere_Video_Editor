{
 "id": "letterpress",
 "label": "Letterpress",
 "category": "Stylize",
 "tags": ["look"],
 "version": 1,
 "blurb": "Prints the picture from a relief plate pressed hard into thick cotton paper: the inked shapes sink below the paper with a lit wall and a shadowed wall, ink squeezes out into a dark rim at every edge, and big solids come out mottled where the paper's tooth missed the ink.",
 "params": [
  {"key": "plate", "label": "Plate", "type": "enum", "choices": ["Line block", "Halftone block"], "default": 0},
  {"key": "level", "label": "Ink level", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.42},
  {"key": "smoothing", "label": "Plate smoothing", "type": "float", "min": 0.0, "max": 8.0, "step": 0.1, "default": 2.0, "unit": " px"},
  {"key": "screen", "label": "Halftone screen", "type": "float", "min": 3.0, "max": 24.0, "step": 0.1, "default": 7.0, "unit": " px"},
  {"key": "depth", "label": "Impression", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.6},
  {"key": "bite", "label": "Impression width", "type": "float", "min": 1.0, "max": 16.0, "step": 0.1, "default": 5.0, "unit": " px"},
  {"key": "light_angle", "label": "Light from", "type": "float", "min": -180.0, "max": 180.0, "step": 1.0, "default": -135.0, "unit": " deg"},
  {"key": "squeeze", "label": "Ink squeeze", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.6},
  {"key": "coverage", "label": "Ink coverage", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.72},
  {"key": "tooth", "label": "Paper tooth", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.5},
  {"key": "ink", "label": "Ink", "type": "color", "default": [0.1, 0.12, 0.2, 1.0]},
  {"key": "paper", "label": "Paper", "type": "color", "default": [0.95, 0.93, 0.88, 1.0]},
  {"key": "seed", "label": "Seed", "type": "int", "min": 0, "max": 999, "step": 1, "default": 7}
 ],
 "handles": [{"kind": "angle", "key": "light_angle", "zero": "right", "turn": "cw"}],
 "panels": [{"kind": "light_ball", "bind": {"angle": "light_angle"}, "options": {"zero": "right", "turn": "cw"}}],
 "passes": [
  {"shader": "plate.gdshader"},
  {"shader": "bite.gdshader", "scale": 0.5, "set": {"direction": [1.0, 0.0]}},
  {"shader": "bite.gdshader", "set": {"direction": [0.0, 1.0]}},
  {"shader": "press.gdshader", "scale": 2.0, "inputs": {"plate_tex": 0}}
 ]
}
