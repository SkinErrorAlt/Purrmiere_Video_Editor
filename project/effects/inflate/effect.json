  {"key": "inflate", "label": "Inflate", "type": "float", "min": 0.0, "max": 1.0, "step": 0.001, "default": 1.0},
  {"key": "height", "label": "Height", "type": "float", "min": 0.0, "max": 100.0, "step": 0.1, "default": 55.0},
