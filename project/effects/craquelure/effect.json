  {"key": "crack_depth", "label": "Crack depth", "type": "float", "min": 0.0, "max": 10.0, "step": 0.1, "default": 6.0},
  {"key": "crack_brightness", "label": "Crack brightness", "type": "float", "min": 0.0, "max": 10.0, "step": 0.1, "default": 9.0},
  {"key": "light_angle", "label": "Light direction", "type": "float", "min": -180.0, "max": 180.0, "step": 1.0, "default": 135.0, "unit": " deg"},
  {"key": "seed", "label": "Seed", "type": "int", "min": 0, "max": 9999, "step": 1, "default": 0}
 ],
 "handles": [{"kind": "angle", "key": "light_angle", "zero": "right", "turn": "ccw"}],
