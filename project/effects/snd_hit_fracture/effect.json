{
 "id": "snd_hit_fracture",
 "label": "Hit Fracture",
 "category": "Audio Reactive",
 "tags": [
  "audio",
  "reactive",
  "impact",
  "glass"
 ],
 "version": 1,
 "blurb": "The picture is a pane of glass that remembers the sound. Every big hit since the clip began cracks it a little more: a star of cracks races out from a new spot, the shards shift the picture behind them and catch the light, and nothing heals until the clip ends. Quiet clips stay clear; a gunfight leaves the frame in pieces.",
 "params": [
  {
   "key": "crack_size",
   "label": "Crack size",
   "type": "float",
   "min": 0.05,
   "max": 1.0,
   "step": 0.01,
   "default": 0.5
  },
  {
   "key": "min_hit",
   "label": "Hits that crack",
   "type": "float",
   "min": 0.0,
   "max": 1.0,
   "step": 0.01,
   "default": 0.6
  },
  {
   "key": "shift",
   "label": "Shard shift",
   "type": "float",
   "min": 0.0,
   "max": 40.0,
   "step": 0.1,
   "default": 5.0,
   "unit": " px"
  },
  {
   "key": "glint",
   "label": "Glint",
   "type": "float",
   "min": 0.0,
   "max": 1.0,
   "step": 0.01,
   "default": 0.7
  },
  {
   "key": "light_angle",
   "label": "Light from",
   "type": "float",
   "min": -180.0,
   "max": 180.0,
   "step": 0.5,
   "default": -40.0,
   "unit": " deg"
  },
  {
   "key": "spread",
   "label": "Spread",
   "type": "float",
   "min": 0.0,
   "max": 1.0,
   "step": 0.01,
   "default": 0.75
  },
  {
   "key": "centre",
   "label": "Centre",
   "type": "vec2",
   "default": [
    0.5,
    0.5
   ]
  },
  {
   "key": "seed",
   "label": "Seed",
   "type": "int",
   "min": 0,
   "max": 9999,
   "step": 1,
   "default": 0
  }
 ],
 "passes": [
  {
   "shader": "effect.gdshader"
  }
 ],
 "reactive": {
  "listen": {
   "hits": 64
  },
  "defaults": {
   "snd_threshold": 5.0
  }
 },
 "handles": [
  {
   "kind": "point",
   "key": "centre"
  },
  {
   "kind": "angle",
   "key": "light_angle",
   "about": "centre"
  }
 ]
}