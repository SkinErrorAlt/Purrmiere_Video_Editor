uniform vec4 colour_3 : source_color = vec4(0.95, 0.55, 0.3, 1.0);
uniform vec4 colour_4 : source_color = vec4(1.0, 0.93, 0.75, 1.0);
uniform vec2 tex_size = vec2(1.0, 1.0);
uniform float px_scale = 1.0;

