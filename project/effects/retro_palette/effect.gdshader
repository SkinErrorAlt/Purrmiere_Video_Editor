uniform float dither : hint_range(0.0, 1.0) = 0.5;
uniform float pixel_size : hint_range(1.0, 32.0) = 3.0;
uniform bool lightness_only = false;
uniform vec4 colour_1 : source_color = vec4(0.13, 0.08, 0.2, 1.0);
