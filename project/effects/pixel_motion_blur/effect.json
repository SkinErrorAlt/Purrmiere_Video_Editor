{
 "id": "pixel_motion_blur",
 "label": "Pixel Motion Blur",
 "category": "Time",
 "tags": ["look"],
 "version": 1,
 "blurb": "Real motion blur worked out from how every part of the picture actually moved since the frame before: a swinging arm streaks along its swing, a passing car smears along the road and the still street stays sharp, as if the shot had been filmed with a slower shutter. Shutter angle works like a film camera's: 180 is the usual film look, 360 and more smear further, small angles stay crisp.",
 "history": {"max": 1},
 "params": [
  {"key": "shutter", "label": "Shutter angle", "type": "float", "min": 0.0, "max": 720.0, "step": 1.0, "default": 270.0, "unit": " deg"},
  {"key": "samples", "label": "Quality", "type": "int", "min": 4, "max": 48, "step": 1, "default": 20},
  {"key": "ignore_under", "label": "Ignore movement under", "type": "float", "min": 0.0, "max": 8.0, "step": 0.1, "default": 0.8, "unit": " px"},
  {"key": "max_length", "label": "Longest streak", "type": "float", "min": 8.0, "max": 480.0, "step": 1.0, "default": 240.0, "unit": " px"}
 ],
 "passes": [
  {"shader": "luma.gdshader", "scale": 0.5, "set": {"stage": 0, "age": 1.0}},
  {"shader": "luma.gdshader", "scale": 0.5, "set": {"stage": 1}},
  {"shader": "luma.gdshader", "scale": 0.5, "set": {"stage": 1}},
  {"shader": "luma.gdshader", "scale": 0.5, "set": {"stage": 1}},
  {"shader": "search.gdshader", "scale": 1.0, "set": {"radius": 6, "level_scale": 16.0, "patch": 2, "lambda": 0.004}},
  {"shader": "refine.gdshader", "scale": 2.0, "set": {"level_scale": 8.0, "patch": 1, "lambda": 0.004}, "inputs": {"luma_tex": 2}},
  {"shader": "refine.gdshader", "scale": 2.0, "set": {"level_scale": 4.0, "patch": 1, "lambda": 0.004, "half_step": true}, "inputs": {"luma_tex": 1}},
  {"shader": "smooth.gdshader", "scale": 1.0},
  {"shader": "blur.gdshader", "scale": 4.0}
 ]
}
