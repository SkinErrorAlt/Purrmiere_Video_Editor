{
 "id": "face_blur",
 "label": "Face Blur",
 "category": "Blur & Sharpen",
 "version": 1,
 "blurb": "Hides a face, a name tag or a screen with a heavy blur, big pixels or a solid colour inside a soft oval or rounded box, for people who did not agree to be filmed. Drag the centre onto the face on the Program monitor; with Record on, dragging as the clip plays writes keys, so the spot follows the face. A second spot covers a second face. The blur is strong enough that it cannot be read, whatever the spot size.",
 "params": [
  {"key": "centre", "label": "Centre", "type": "vec2", "default": [0.5, 0.4]},
  {"key": "size", "label": "Size", "type": "float", "min": 0.02, "max": 1.0, "step": 0.005, "default": 0.25},
  {"key": "stretch", "label": "Width to height", "type": "float", "min": 0.3, "max": 3.0, "step": 0.01, "default": 0.8},
  {"key": "rotation", "label": "Turn", "type": "float", "min": -180.0, "max": 180.0, "step": 0.5, "default": 0.0, "unit": " deg"},
  {"key": "shape", "label": "Shape", "type": "enum", "choices": ["Oval", "Rounded box"], "default": 0},
  {"key": "style", "label": "Hide with", "type": "enum", "choices": ["Blur", "Big pixels", "Solid colour"], "default": 0},
  {"key": "blocks", "label": "Pixels across", "type": "float", "min": 3.0, "max": 40.0, "step": 1.0, "default": 9.0},
  {"key": "colour", "label": "Colour", "type": "color", "default": [0.05, 0.05, 0.05, 1.0]},
  {"key": "feather", "label": "Soft edge", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.2},
  {"key": "second", "label": "Second spot", "type": "bool", "default": false},
  {"key": "centre_2", "label": "Second centre", "type": "vec2", "default": [0.7, 0.4]},
  {"key": "size_2", "label": "Second size", "type": "float", "min": 0.02, "max": 1.0, "step": 0.005, "default": 0.25},
  {"key": "show_outline", "label": "Show the outline", "type": "bool", "default": false}
 ],
 "handles": [{"kind": "point", "key": "centre"}, {"kind": "ring", "key": "size", "about": "centre", "unit": "h", "scale": 2.0, "stretch": "stretch", "rotate": "rotation", "feather": "feather", "feather_mode": "outer", "feather_scale": 0.6}, {"kind": "angle", "key": "rotation", "about": "centre"}, {"kind": "point", "key": "centre_2", "when": {"key": "second", "is": [true]}}, {"kind": "ring", "key": "size_2", "about": "centre_2", "unit": "h", "scale": 2.0, "stretch": "stretch", "rotate": "rotation", "feather": "feather", "feather_mode": "outer", "feather_scale": 0.6, "when": {"key": "second", "is": [true]}}],
 "passes": [
  {"shader": "res://effects/glow/down13.gdshader", "scale": 0.5},
  {"shader": "res://effects/glow/down13.gdshader", "scale": 0.5},
  {"shader": "res://effects/glow/down13.gdshader", "scale": 0.5},
  {"shader": "res://effects/glow/down13.gdshader", "scale": 0.5},
  {"shader": "face.gdshader", "scale": 16.0, "inputs": {"mid_tex": 1}}
 ]
}
