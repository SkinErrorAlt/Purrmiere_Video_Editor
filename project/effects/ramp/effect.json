{
 "id": "ramp",
 "label": "Ramp",
 "category": "Image Control",
 "version": 1,
 "blurb": "A gradient laid over the picture, straight or round, with a choice of how it mixes in.",
 "params": [
  {"key": "start_colour", "label": "From", "type": "color", "default": [0.0, 0.0, 0.0, 1.0]},
  {"key": "end_colour", "label": "To", "type": "color", "default": [1.0, 1.0, 1.0, 1.0]},
  {"key": "shape", "label": "Shape", "type": "enum", "default": 0, "choices": ["Straight", "Round", "Square"]},
  {"key": "angle", "label": "Angle", "type": "float", "min": -180.0, "max": 180.0, "step": 1.0, "default": 90.0, "unit": " deg"},
  {"key": "start_at", "label": "Starts at", "type": "float", "min": -1.0, "max": 2.0, "step": 0.005, "default": 0.0},
  {"key": "end_at", "label": "Ends at", "type": "float", "min": -1.0, "max": 2.0, "step": 0.005, "default": 1.0},
  {"key": "blend", "label": "How it mixes", "type": "enum", "default": 0, "choices": ["Replace", "Multiply", "Screen", "Overlay", "Add"]},
  {"key": "strength", "label": "Strength", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 1.0},
  {"key": "centre", "label": "Centre", "type": "vec2", "default": [0.5, 0.5]}
 ],
 "handles": [{"kind": "point", "key": "centre"}, {"kind": "angle", "key": "angle", "about": "centre", "zero": "right", "space": "uv_normal", "when": {"key": "shape", "is": [0]}}],
 "passes": "single"
}
