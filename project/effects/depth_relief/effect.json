  {"key": "shine", "label": "Shine", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.35},
  {"key": "gloss", "label": "Gloss", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.5}
 ],
