{
 "id": "pan_zoom",
 "label": "Pan and Zoom",
 "category": "Transform",
 "version": 1,
 "blurb": "The slow push in and drift across the picture (the Ken Burns move) with no keyframes: set where it starts and ends, and it runs over the whole clip or a set time. It never zooms out far enough to show an edge.",
 "params": [
  {"key": "start_zoom", "label": "Start zoom", "type": "float", "min": 100.0, "max": 400.0, "step": 0.5, "default": 100.0, "unit": " %"},
  {"key": "end_zoom", "label": "End zoom", "type": "float", "min": 100.0, "max": 400.0, "step": 0.5, "default": 115.0, "unit": " %"},
  {"key": "start_centre", "label": "Start centre", "type": "vec2", "default": [0.5, 0.5]},
  {"key": "end_centre", "label": "End centre", "type": "vec2", "default": [0.5, 0.5]},
  {"key": "turn", "label": "Turn by the end", "type": "float", "min": -20.0, "max": 20.0, "step": 0.1, "default": 0.0, "unit": " deg"},
  {"key": "over", "label": "Runs over", "type": "enum", "choices": ["The whole clip", "A set time"], "default": 0},
  {"key": "seconds", "label": "Set time", "type": "float", "min": 0.1, "max": 600.0, "step": 0.1, "default": 5.0, "unit": " s"},
  {"key": "ease", "label": "Ease", "type": "enum", "choices": ["Steady", "Ease in and out", "Ease out", "Ease in"], "default": 0}
 ],
 "handles": [{"kind": "line", "keys": ["start_centre", "end_centre"]}],
 "passes": "single"
}
