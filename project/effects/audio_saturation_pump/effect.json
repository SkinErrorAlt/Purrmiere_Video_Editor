{
 "id": "audio_saturation_pump",
 "label": "Saturation Pump",
 "category": "Audio Reactive",
 "tags": [
  "audio",
  "music",
  "beat",
  "reactive",
  "visualiser"
 ],
 "version": 1,
 "blurb": "Colour drains in the quiet parts and floods back on the loud ones. Drop a clip from the timeline, or a file from the bin or the Source monitor, on its Sound well.",
 "params": [
  {
   "key": "sat_rest",
   "label": "Saturation when quiet",
   "type": "float",
   "min": 0,
   "max": 3,
   "step": 0.01,
   "default": 0.5
  },
  {
   "key": "sat_peak",
   "label": "Saturation when loud",
   "type": "float",
   "min": 0,
   "max": 3,
   "step": 0.01,
   "default": 1.8
  }
 ],
 "passes": [
  {
   "shader": "res://effects/hue_saturation/effect.gdshader"
  }
 ],
 "reactive": {
  "defaults": {
   "snd_band": 1
  },
  "drive": {
   "saturation": {
    "rest": "sat_rest",
    "peak": "sat_peak"
   }
  }
 }
}
