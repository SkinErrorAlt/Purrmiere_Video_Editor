  {"key": "turn", "label": "Second copy turn", "type": "float", "min": -180.0, "max": 180.0, "step": 0.5, "default": 0.0, "unit": " deg"},
  {"key": "fill", "label": "Fill", "type": "enum", "default": 0, "choices": ["Dark areas", "Light areas"]},
  {"key": "tint", "label": "Second copy tint", "type": "color", "default": [0.55, 0.75, 1.0, 1.0]},
  {"key": "amount", "label": "Amount", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.85},
  {"key": "contrast", "label": "Mask contrast", "type": "float", "min": 0.2, "max": 3.0, "step": 0.01, "default": 1.3}
 ],
