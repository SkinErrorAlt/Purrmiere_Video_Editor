 "params": [
  {"key": "picture", "label": "Map picture", "type": "texture", "default": ""},
  {"key": "h_source", "label": "Horizontal from", "type": "enum", "choices": ["Red", "Green", "Blue", "Lightness", "Alpha", "Off"], "default": 0},
  {"key": "v_source", "label": "Vertical from", "type": "enum", "choices": ["Red", "Green", "Blue", "Lightness", "Alpha", "Off"], "default": 1},
  {"key": "h_amount", "label": "Horizontal amount", "type": "float", "min": -400, "max": 400, "step": 0.5, "default": 20, "unit": " px"},
  {"key": "v_amount", "label": "Vertical amount", "type": "float", "min": -400, "max": 400, "step": 0.5, "default": 20, "unit": " px"},
  {"key": "placement", "label": "Map placement", "type": "enum", "choices": ["Stretch to fit", "Tile"], "default": 0},
  {"key": "wrap", "label": "Wrap round the edges", "type": "bool", "default": false}
 ],
 "passes": "single"
}
