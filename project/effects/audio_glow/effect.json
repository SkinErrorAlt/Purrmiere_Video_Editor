{
 "id": "audio_glow",
 "label": "Audio Glow",
 "category": "Audio Reactive",
 "tags": [
  "audio",
  "music",
  "beat",
  "reactive",
  "visualiser"
 ],
 "version": 1,
 "blurb": "Glow and bloom that brighten with the sound. Glow when quiet is the glow left in the silent parts. Drop a clip from the timeline, or a file from the bin or the Source monitor, on its Sound well.",
 "params": [
  {
   "key": "glow_peak",
   "label": "Glow when loud",
   "type": "float",
   "min": 0,
   "max": 4,
   "step": 0.01,
   "default": 1.6
  },
  {
   "key": "glow_rest",
   "label": "Glow when quiet",
   "type": "float",
   "min": 0,
   "max": 4,
   "step": 0.01,
   "default": 0
  },
  {
   "key": "threshold",
   "label": "Threshold",
   "type": "float",
   "min": 0,
   "max": 1,
   "step": 0.01,
   "default": 0.5
  },
  {
   "key": "knee",
   "label": "Soft Knee",
   "type": "float",
   "min": 0,
   "max": 1,
   "step": 0.01,
   "default": 0.3
  },
  {
   "key": "radius",
   "label": "Radius",
   "type": "float",
   "min": 0,
   "max": 1,
   "step": 0.01,
   "default": 0.6
  },
  {
   "key": "tint",
   "label": "Tint",
   "type": "color",
   "default": [
    1,
    1,
    1,
    1
   ]
  },
  {
   "key": "glow_only",
   "label": "Glow Only",
   "type": "bool",
   "default": false
  }
 ],
 "passes": [
  {
   "shader": "res://effects/glow/bright.gdshader"
  },
  {
   "shader": "res://effects/glow/down13.gdshader",
   "scale": 0.5
  },
  {
   "shader": "res://effects/glow/down13.gdshader",
   "scale": 0.5
  },
  {
   "shader": "res://effects/glow/down13.gdshader",
   "scale": 0.5
  },
  {
   "shader": "res://effects/glow/down13.gdshader",
   "scale": 0.5
  },
  {
   "shader": "res://effects/glow/up_tent.gdshader",
   "scale": 2.0,
   "inputs": {
    "level_tex": 3
   }
  },
  {
   "shader": "res://effects/glow/up_tent.gdshader",
   "scale": 2.0,
   "inputs": {
    "level_tex": 2
   }
  },
  {
   "shader": "res://effects/glow/up_tent.gdshader",
   "scale": 2.0,
   "inputs": {
    "level_tex": 1
   }
  },
  {
   "shader": "res://effects/glow/up_tent.gdshader",
   "scale": 2.0,
   "inputs": {
    "level_tex": 0
   }
  },
  {
   "shader": "res://effects/glow/glow_mix.gdshader"
  }
 ],
 "reactive": {
  "drive": {
   "intensity": {
    "rest": "glow_rest",
    "peak": "glow_peak"
   }
  }
 }
}
