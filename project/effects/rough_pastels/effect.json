  {"key": "scaling", "label": "Texture scaling", "type": "float", "min": 50, "max": 200, "step": 1, "default": 100, "unit": " %"},
  {"key": "relief", "label": "Relief", "type": "float", "min": 0, "max": 50, "step": 0.5, "default": 20},
  {"key": "light_angle", "label": "Light from", "type": "float", "min": -180, "max": 180, "step": 1, "default": 90, "unit": " deg"},
