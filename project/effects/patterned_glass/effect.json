  {"key": "refraction", "label": "Refraction", "type": "float", "min": 0.0, "max": 2.0, "step": 0.01, "default": 1.0},
  {"key": "angle", "label": "Angle", "type": "float", "min": -180.0, "max": 180.0, "step": 0.1, "default": 0.0, "unit": " deg"},
  {"key": "blur", "label": "Blur behind the glass", "type": "float", "min": 0.0, "max": 30.0, "step": 0.1, "default": 1.5, "unit": " px"},
  {"key": "highlight", "label": "Highlight", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.4},
  {"key": "tint", "label": "Tint", "type": "color", "default": [0.96, 0.99, 1.0, 1.0]},
  {"key": "seed", "label": "Seed", "type": "int", "min": 0, "max": 9999, "step": 1, "default": 0}
 ],
