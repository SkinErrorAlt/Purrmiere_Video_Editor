{
 "id": "bounce_slide",
 "label": "Bounce Slide",
 "category": "Transform",
 "version": 1,
 "blurb": "The clip whooshes in from off screen with motion blur, overshoots and springs back into place, then whooshes off at its end, carrying on the same way or going back where it came from. The go to move for a face cam, a picture in picture, a meme or a card sliding on; the track below shows round it. Use Progress to key it by hand (0 is in place, 1 is off screen).",
 "params": [
  {"key": "when", "label": "When", "type": "enum", "choices": ["In at the start and out at the end", "In at the start", "Out at the end", "By Progress"], "default": 0},
  {"key": "duration", "label": "Slide length", "type": "float", "min": 0.1, "max": 3.0, "step": 0.01, "default": 0.5, "unit": " s"},
  {"key": "progress", "label": "Progress", "type": "float", "min": 0.0, "max": 1.0, "step": 0.005, "default": 0.0},
  {"key": "angle", "label": "Moves towards", "type": "float", "min": -180.0, "max": 180.0, "step": 1.0, "default": 90.0, "unit": " deg"},
  {"key": "leaves", "label": "Leaves", "type": "enum", "choices": ["Carrying on the same way", "Back the way it came"], "default": 0},
  {"key": "bounce", "label": "Bounce", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.5},
  {"key": "blur", "label": "Motion blur", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.6},
  {"key": "squash", "label": "Stretch", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.3}
 ],
 "handles": [{"kind": "angle", "key": "angle"}],
 "passes": "single"
}
