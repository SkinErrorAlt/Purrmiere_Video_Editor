{
 "id": "before_after",
 "label": "Before and After",
 "category": "Utility",
 "tags": ["measure"],
 "version": 1,
 "blurb": "Put it last on a graded clip to compare: one side of a line shows the clip as it came in, before any effect, and the other side shows the grade. Drag the line and turn it on the Program monitor, or show the two pictures side by side. Labels read BEFORE and AFTER, handy for a before and after in the video itself.",
 "params": [
  {"key": "mode", "label": "Show", "type": "enum", "choices": ["Split at a line", "Side by side"], "default": 0},
  {"key": "split", "label": "Line through", "type": "vec2", "default": [0.5, 0.5]},
  {"key": "angle", "label": "Line turn", "type": "float", "min": -180.0, "max": 180.0, "step": 0.5, "default": 0.0, "unit": " deg"},
  {"key": "swap", "label": "Before on the right", "type": "bool", "default": false},
  {"key": "line_width", "label": "Line width", "type": "float", "min": 0.0, "max": 10.0, "step": 0.1, "default": 2.0, "unit": " px"},
  {"key": "line_colour", "label": "Line colour", "type": "color", "default": [1.0, 1.0, 1.0, 1.0]},
  {"key": "labels", "label": "Labels", "type": "bool", "default": true},
  {"key": "label_size", "label": "Label size", "type": "float", "min": 0.5, "max": 3.0, "step": 0.05, "default": 1.0}
 ],
 "handles": [{"kind": "point", "key": "split", "when": {"key": "mode", "is": [0]}}, {"kind": "angle", "key": "angle", "about": "split", "zero": "right", "when": {"key": "mode", "is": [0]}}],
 "passes": "single"
}
