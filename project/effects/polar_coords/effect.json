{
 "id": "polar_coords",
 "label": "Polar Coordinates",
 "category": "Distort",
 "version": 1,
 "blurb": "Wraps the picture round a circle, or unwraps a circle into a straight strip.",
 "params": [
  {"key": "mode", "label": "Mode", "type": "enum", "default": 0, "choices": ["Rectangle to polar", "Polar to rectangle"]},
  {"key": "centre", "label": "Centre", "type": "vec2", "default": [0.5, 0.5]},
  {"key": "spin", "label": "Rotation", "type": "float", "min": -360.0, "max": 360.0, "step": 1.0, "default": 0.0, "unit": " deg"},
  {"key": "scale_r", "label": "Radius scale", "type": "float", "min": 0.1, "max": 4.0, "step": 0.01, "default": 1.0}
 ],
 "handles": [{"kind": "point", "key": "centre"}, {"kind": "angle", "key": "spin", "about": "centre", "zero": "up", "turn": "ccw", "when": {"key": "mode", "is": [0]}}],
 "passes": "single"
}
