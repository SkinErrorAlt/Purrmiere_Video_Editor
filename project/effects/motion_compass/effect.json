{
 "id": "motion_compass",
 "label": "Motion Compass",
 "category": "Time",
 "tags": [
  "look"
 ],
 "version": 1,
 "blurb": "Colours everything that moves by the way it is heading, like a compass: everything going right turns red, everything going down turns gold, left is green and up is blue, with every heading in between, and the faster it goes the stronger the colour. A crowd crossing both ways splits into two colours, a juggler's balls change colour as they rise and fall, a dancer's arms show which way they swing. The still world stays a quiet grey. Tint keeps the picture and colours it; Field on black shows the movement alone; Glowing outlines draws the moving edges in their heading colours. Ignore camera movement takes out a pan so only things moving in the scene light up.",
 "history": {
  "max": 1
 },
 "params": [
  {
   "key": "look",
   "label": "Look",
   "type": "enum",
   "choices": [
    "Tint the picture",
    "Field on black",
    "Glowing outlines"
   ],
   "default": 0
  },
  {
   "key": "full_speed",
   "label": "Full colour at",
   "type": "float",
   "min": 1.0,
   "max": 80.0,
   "step": 0.1,
   "default": 6.0,
   "unit": " px"
  },
  {
