{
 "id": "cut_carryover",
 "label": "Colour Carry-Over",
 "category": "Time",
 "tags": ["look"],
 "version": 1,
 "blurb": "Finds every cut inside the clip and lets the new shot arrive in the colours of the shot before it: cut from a red-lit club to a grey street and the street comes in red, holds it for a beat and then lets its own colour bleed back. It matches the old shot's colour, brightness and contrast, worked out from its last frame, so each cut carries a little of the last shot into the next. No keyframes and no splitting.",
 "history": {"max": 62, "reach": ["carry", 1.1], "seconds": ["carry"]},
 "params": [
  {"key": "carry", "label": "Lets go over", "type": "float", "min": 0.2, "max": 1.8, "step": 0.01, "default": 1.4, "unit": " s"},
  {"key": "hold", "label": "Holds before letting go", "type": "float", "min": 0.0, "max": 0.8, "step": 0.01, "default": 0.25},
  {"key": "strength", "label": "Strength", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.9},
  {"key": "keep_contrast", "label": "Keep the new shot's contrast", "type": "bool", "default": false},
  {"key": "sensitivity", "label": "Cut sensitivity", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.5}
 ],
 "passes": [
  {"shader": "res://effects/_events/thumbs.gdshader", "scale": 0.125},
  {"shader": "res://effects/_events/stats_change.gdshader", "scale": 0.25},
  {"shader": "res://effects/_events/track_cut.gdshader", "scale": 1.0, "inputs": {"thumb_tex": 0}, "map": {"look_back": "carry"}},
  {"shader": "apply.gdshader", "scale": 32.0}
 ]
}
