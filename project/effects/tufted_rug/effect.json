  {"key": "saturation", "label": "Yarn saturation", "type": "float", "min": 0.0, "max": 2.0, "step": 0.01, "default": 1.15},
  {"key": "carve", "label": "Carving", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.75},
  {"key": "carve_width", "label": "Groove width", "type": "float", "min": 1.0, "max": 20.0, "step": 0.1, "default": 5.0, "unit": " px"},
