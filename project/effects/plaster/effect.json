{
 "id": "plaster",
 "label": "Plaster",
 "category": "Stylize",
 "tags": ["look"],
 "version": 1,
 "blurb": "Moulds the picture in glossy plaster: the dark parts stand up as smooth raised shapes, lit from one side.",
 "params": [
  {"key": "image_balance", "label": "Image balance", "type": "float", "min": 0, "max": 50, "step": 0.5, "default": 20},
  {"key": "smoothness", "label": "Smoothness", "type": "float", "min": 1, "max": 15, "step": 0.1, "default": 2},
  {"key": "light_angle", "label": "Light from", "type": "float", "min": -180, "max": 180, "step": 1, "default": 90, "unit": " deg"},
  {"key": "plaster_colour", "label": "Plaster", "type": "color", "default": [0.93, 0.92, 0.89, 1.0]},
  {"key": "raised_colour", "label": "Raised parts", "type": "color", "default": [0.2, 0.19, 0.19, 1.0]}
 ],
 "handles": [{"kind": "angle", "key": "light_angle", "zero": "right", "turn": "ccw"}],
 "panels": [{"kind": "light_ball", "bind": {"angle": "light_angle"}, "options": {"zero": "right", "turn": "ccw"}}],
 "passes": [
  {"shader": "soften.gdshader", "set": {"direction": [1, 0]}},
  {"shader": "soften.gdshader", "set": {"direction": [0, 1]}},
  {"shader": "mould.gdshader"}
 ]
}
