 "params": [
  {"key": "at", "label": "Punch at", "type": "float", "min": 0.0, "max": 600.0, "step": 0.01, "default": 0.0, "unit": " s"},
  {"key": "zoom", "label": "Zoom", "type": "float", "min": -50.0, "max": 300.0, "step": 0.5, "default": 30.0, "unit": " %"},
  {"key": "punch_time", "label": "Punch in over", "type": "float", "min": 0.01, "max": 2.0, "step": 0.01, "default": 0.12, "unit": " s"},
  {"key": "hold", "label": "Hold for", "type": "float", "min": 0.0, "max": 600.0, "step": 0.01, "default": 2.0, "unit": " s"},
  {"key": "release", "label": "Ease back over", "type": "float", "min": 0.0, "max": 3.0, "step": 0.01, "default": 0.25, "unit": " s"},
  {"key": "repeat", "label": "Repeat every (0 is once)", "type": "float", "min": 0.0, "max": 60.0, "step": 0.01, "default": 0.0, "unit": " s"},
  {"key": "bounce", "label": "Bounce", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.35},
  {"key": "centre", "label": "Zoom towards", "type": "vec2", "default": [0.5, 0.5]},
  {"key": "turn", "label": "Turn", "type": "float", "min": -45.0, "max": 45.0, "step": 0.1, "default": 0.0, "unit": " deg"},
  {"key": "blur", "label": "Motion blur", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.6},
  {"key": "jolt", "label": "Jolt on the hit", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.0},
  {"key": "edges", "label": "Edges when zooming out", "type": "enum", "choices": ["Mirror", "Repeat", "Transparent"], "default": 0}
 ],
 "handles": [{"kind": "point", "key": "centre"}],
