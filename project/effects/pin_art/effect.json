  {"key": "shadows", "label": "Shadows", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.85},
  {"key": "shine", "label": "Glint", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.7},
  {"key": "seed", "label": "Seed", "type": "int", "min": 0, "max": 999, "step": 1, "default": 0}
 ],
