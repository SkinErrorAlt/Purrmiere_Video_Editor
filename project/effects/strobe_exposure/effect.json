  {"key": "flashes", "label": "Flashes kept", "type": "int", "min": 2, "max": 12, "step": 1, "default": 7},
  {"key": "scene", "label": "Scene", "type": "enum", "choices": ["Dark studio", "Night scene"], "default": 0},
  {"key": "ambient", "label": "Light between flashes", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.22},
  {"key": "decay", "label": "Each older flash keeps", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.86},
  {"key": "flash_power", "label": "Flash strength", "type": "float", "min": 0.2, "max": 3.0, "step": 0.01, "default": 1.15},
  {"key": "flash_colour", "label": "Flash colour", "type": "color", "default": [1.0, 0.97, 0.92, 1.0]},
  {"key": "threshold", "label": "What counts as moving", "type": "float", "min": 0.01, "max": 0.5, "step": 0.005, "default": 0.12},
