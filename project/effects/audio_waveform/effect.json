{
 "id": "audio_waveform",
 "label": "Waveform",
 "category": "Audio Reactive",
 "tags": [
  "audio",
  "music",
  "beat",
  "reactive",
  "visualiser"
 ],
 "version": 1,
 "blurb": "Draws the sound over the picture as a scrolling waveform: the last few seconds, newest at the right. Drop a clip from the timeline, or a file from the bin or the Source monitor, on its Sound well.",
 "params": [
  {
   "key": "colour",
   "label": "Colour",
   "type": "color",
   "default": [
    1.0,
    0.45,
    0.75,
    1
   ]
  },
  {
   "key": "span",
   "label": "Time shown",
   "type": "float",
   "min": 0.25,
   "max": 20,
   "step": 0.05,
   "default": 3,
   "unit": " s"
  },
  {
   "key": "style",
   "label": "Style",
   "type": "enum",
   "choices": [
    "Mirrored",
    "Line",
    "Bars"
   ],
   "default": 0
  },
  {
   "key": "position",
   "label": "Height on screen",
   "type": "float",
   "min": 0,
   "max": 1,
   "step": 0.01,
   "default": 0.8
  },
  {
   "key": "width",
   "label": "Width",
   "type": "float",
   "min": 0.05,
   "max": 1,
   "step": 0.01,
   "default": 0.9
  },
  {
   "key": "height",
   "label": "Size",
   "type": "float",
   "min": 0.01,
   "max": 1,
   "step": 0.01,
   "default": 0.3
  },
  {
   "key": "thickness",
   "label": "Line width",
   "type": "float",
   "min": 0.5,
   "max": 40,
   "step": 0.5,
   "default": 4,
   "unit": " px"
  },
  {
   "key": "bars",
   "label": "Bars",
   "type": "float",
   "min": 4,
   "max": 256,
   "step": 1,
   "default": 64
  },
  {
   "key": "gap",
   "label": "Gap",
   "type": "float",
   "min": 0,
   "max": 0.9,
   "step": 0.01,
   "default": 0.3
  },
  {
   "key": "opacity",
   "label": "Opacity",
   "type": "float",
   "min": 0,
   "max": 1,
   "step": 0.01,
   "default": 1
  }
 ],
 "handles": [{"kind": "edges", "top": "position"}],
 "passes": [
  {
   "shader": "effect.gdshader"
  }
 ],
 "reactive": {
  "defaults": {
   "snd_attack": 0,
   "snd_release": 60,
   "snd_threshold": 0
  },
  "wave": {
   "uniform": "wave_tex",
   "points": 128,
   "span": "span"
  },
  "look": true
 }
}
