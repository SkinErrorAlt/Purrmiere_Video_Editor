{
 "id": "lens_dirt",
 "label": "Lens Dirt",
 "category": "Light & Shadow",
 "tags": ["light"],
 "version": 1,
 "blurb": "A dirty lens catching the light: the glow from bright parts lights up smudges, dust specks and wipe marks on the glass, the way the sun or a muzzle flash does in a game or on a real camera. Dark shots stay clean.",
 "params": [
  {"key": "threshold", "label": "Brightness needed", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.7},
  {"key": "intensity", "label": "Intensity", "type": "float", "min": 0.0, "max": 4.0, "step": 0.01, "default": 1.3},
  {"key": "dirt", "label": "Dirt", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.75},
  {"key": "plain_glow", "label": "Glow on clean glass", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.2},
  {"key": "spread", "label": "Spread", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.6},
  {"key": "dirt_size", "label": "Dirt size", "type": "float", "min": 0.3, "max": 3.0, "step": 0.01, "default": 1.0},
  {"key": "tint", "label": "Tint", "type": "color", "default": [1.0, 0.94, 0.84, 1.0]},
  {"key": "seed", "label": "Seed", "type": "int", "min": 0, "max": 9999, "step": 1, "default": 0},
  {"key": "show_dirt", "label": "Show the dirt only", "type": "bool", "default": false}
 ],
 "passes": [
  {"shader": "res://effects/glow/bright.gdshader", "scale": 0.5, "set": {"knee": 0.5}},
  {"shader": "res://effects/glow/down13.gdshader", "scale": 0.5},
  {"shader": "res://effects/glow/down13.gdshader", "scale": 0.5},
  {"shader": "res://effects/glow/down13.gdshader", "scale": 0.5},
  {"shader": "res://effects/glow/down13.gdshader", "scale": 0.5},
  {"shader": "res://effects/glow/up_tent.gdshader", "scale": 2.0, "inputs": {"level_tex": 3}, "map": {"radius": "spread"}},
  {"shader": "res://effects/glow/up_tent.gdshader", "scale": 2.0, "inputs": {"level_tex": 2}, "map": {"radius": "spread"}},
  {"shader": "res://effects/glow/up_tent.gdshader", "scale": 2.0, "inputs": {"level_tex": 1}, "map": {"radius": "spread"}},
  {"shader": "dirt.gdshader", "scale": 4.0}
 ]
}
