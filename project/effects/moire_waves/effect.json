{
 "id": "moire_waves",
 "label": "Moire Waves",
 "category": "Stylize",
 "version": 1,
 "blurb": "Two sets of fine rules are laid over one another at a slight angle, and where they cross they beat against each other and throw up the wide rolling bands of a moire pattern, the op art effect you get photographing a screen or printing one halftone on top of another. The picture itself bends one of the two sets, so its shapes come through in the beat rather than in the lines, and a small change in angle or pitch swings the pattern right across the frame. The rules can be straight or thrown into rings round a point.",
 "params": [
  {"key": "pitch", "label": "Rule spacing", "type": "float", "min": 1.0, "max": 30.0, "step": 0.25, "default": 5.0, "unit": " px"},
  {"key": "angle_a", "label": "First angle", "type": "float", "min": -180.0, "max": 180.0, "step": 0.5, "default": 0.0, "unit": " deg"},
  {"key": "angle_b", "label": "Second angle", "type": "float", "min": -180.0, "max": 180.0, "step": 0.5, "default": 4.0, "unit": " deg"},
  {"key": "rings", "label": "Rings instead", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.0},
  {"key": "centre", "label": "Ring centre", "type": "vec2", "default": [0.5, 0.5]},
  {"key": "bend", "label": "Picture bends them", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.45},
  {"key": "ink", "label": "Dark", "type": "color", "default": [0.05, 0.05, 0.08, 1.0]},
  {"key": "light", "label": "Light", "type": "color", "default": [0.96, 0.96, 0.98, 1.0]},
  {"key": "strength", "label": "Strength", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 1.0}
 ],
 "handles": [{"kind": "point", "key": "centre"}, {"kind": "angle", "key": "angle_a", "about": "centre", "zero": "right", "turn": "cw"}, {"kind": "angle", "key": "angle_b", "about": "centre", "zero": "left", "turn": "cw"}],
 "passes": "single"
}
