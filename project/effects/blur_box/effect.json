{
 "id": "blur_box",
 "label": "Box Blur",
 "category": "Blur & Sharpen",
 "version": 1,
 "blurb": "A separable box blur. Three iterations come close to a gaussian.",
 "params": [
  {"key": "size", "label": "Blur Radius", "type": "float", "min": 0, "max": 100, "step": 0.1, "default": 3},
  {"key": "iterations", "label": "Iterations", "type": "int", "min": 1, "max": 3, "step": 1, "default": 1},
  {"key": "edge", "label": "Repeat Edge Pixels", "type": "bool", "default": true}
 ],
 "passes": [
  {"shader": "box.gdshader", "set": {"direction": [1.0, 0.0]}, "repeat": {"param": "iterations", "max": 3}},
  {"shader": "box.gdshader", "set": {"direction": [0.0, 1.0]}, "repeat": {"param": "iterations", "max": 3}}
 ]
}
