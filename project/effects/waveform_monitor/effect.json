  {"key": "size", "label": "Size", "type": "float", "min": 0.1, "max": 1, "step": 0.01, "default": 0.35},
  {"key": "backdrop", "label": "Backdrop", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.75},
  {"key": "gain", "label": "Trace brightness", "type": "float", "min": 0.2, "max": 8, "step": 0.05, "default": 2.0},
