{
 "id": "silk_embroidery",
 "label": "Silk Embroidery",
 "category": "Stylize",
 "tags": ["look"],
 "version": 1,
 "blurb": "Sews the picture in silk shading, the long and short stitch of needle painting: rows of floss stitches laid along the shapes of the picture, each one a single thread colour from a limited skein box, with the twist of the plies showing, a gap where the needle goes back into the cloth, and the silk's sheen that flashes on stitches running one way and goes dull on the others. Turn Light to make the sheen move across the work.",
 "params": [
  {"key": "stitch_length", "label": "Stitch length", "type": "float", "min": 4.0, "max": 80.0, "step": 0.5, "default": 20.0, "unit": " px"},
  {"key": "thread_width", "label": "Thread width", "type": "float", "min": 1.0, "max": 12.0, "step": 0.1, "default": 3.0, "unit": " px"},
  {"key": "follow", "label": "Stitches run", "type": "enum", "choices": ["Along the shapes", "Across the shapes", "One way"], "default": 0},
  {"key": "angle", "label": "Angle where flat", "type": "float", "min": -180.0, "max": 180.0, "step": 1.0, "default": 60.0, "unit": " deg"},
  {"key": "colours", "label": "Thread colours per channel", "type": "int", "min": 0, "max": 32, "step": 1, "default": 9},
  {"key": "sheen", "label": "Silk sheen", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.65},
  {"key": "light_angle", "label": "Light", "type": "float", "min": -180.0, "max": 180.0, "step": 1.0, "default": 135.0, "unit": " deg"},
  {"key": "bare", "label": "Bare cloth in the light", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.0},
  {"key": "cloth", "label": "Cloth", "type": "color", "default": [0.86, 0.82, 0.73, 1.0]},
  {"key": "seed", "label": "Seed", "type": "int", "min": 0, "max": 9999, "step": 1, "default": 0}
 ],
 "handles": [{"kind": "angle", "key": "light_angle"}],
 "passes": [
  {"shader": "field.gdshader", "scale": 0.25},
  {"shader": "smooth.gdshader", "scale": 1.0, "set": {"reach": 1.5}},
  {"shader": "smooth.gdshader", "scale": 1.0, "set": {"reach": 3.0}},
  {"shader": "stitch.gdshader", "scale": 4.0}
 ]
}
