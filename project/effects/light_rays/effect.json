{
 "id": "light_rays",
 "label": "Light Rays",
 "category": "Light & Shadow",
 "tags": ["light"],
 "version": 1,
 "blurb": "Shafts of light streaming out from a point: the bright parts of the picture are smeared outward from the centre in three passes and added back.",
 "params": [
  {"key": "centre", "label": "Centre", "type": "vec2", "default": [0.5, 0.25]},
  {"key": "threshold", "label": "Threshold", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.8},
  {"key": "length", "label": "Length", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.5},
  {"key": "intensity", "label": "Intensity", "type": "float", "min": 0, "max": 4, "step": 0.01, "default": 1},
  {"key": "colour", "label": "Colour", "type": "color", "default": [1.0, 0.93, 0.78, 1.0]},
  {"key": "rays_only", "label": "Rays only", "type": "bool", "default": false}
 ],
 "handles": [{"kind": "point", "key": "centre"}],
 "passes": [
  {"shader": "bright.gdshader", "scale": 0.5},
  {"shader": "rays.gdshader", "set": {"span": 0.0625}, "map": {"ray_length": "length"}},
  {"shader": "rays.gdshader", "set": {"span": 0.25}, "map": {"ray_length": "length"}},
  {"shader": "rays.gdshader", "set": {"span": 1.0}, "map": {"ray_length": "length"}},
  {"shader": "compose.gdshader", "scale": 2.0}
 ]
}
