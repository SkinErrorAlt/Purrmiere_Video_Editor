{
 "id": "bevel_emboss",
 "label": "Bevel and Emboss",
 "category": "Light & Shadow",
 "version": 1,
 "blurb": "Lights the shape of whatever has alpha as if it were raised off the frame: a bevel cut into its edge, a bevel outside it, an emboss that does both, or a pillow emboss that looks pressed in. The slope follows the true outline, so letters, logos and cut outs keep an even bevel all the way round. Bevel Edges only bevels the frame itself. Drag the light on the monitor to turn it.",
 "params": [
  {"key": "style", "label": "Style", "type": "enum", "choices": ["Inner bevel", "Outer bevel", "Emboss", "Pillow emboss"], "default": 0},
  {"key": "technique", "label": "Technique", "type": "enum", "choices": ["Smooth", "Chisel"], "default": 0},
  {"key": "size", "label": "Size", "type": "float", "min": 1.0, "max": 100.0, "step": 0.1, "default": 12.0, "unit": " px"},
  {"key": "depth", "label": "Depth", "type": "float", "min": 0.0, "max": 5.0, "step": 0.01, "default": 1.5},
  {"key": "press_in", "label": "Press in", "type": "bool", "default": false},
  {"key": "light_angle", "label": "Light direction", "type": "float", "min": -180.0, "max": 180.0, "step": 1.0, "default": -45.0, "unit": "deg"},
  {"key": "altitude", "label": "Light height", "type": "float", "min": 0.0, "max": 90.0, "step": 1.0, "default": 35.0, "unit": "deg"},
  {"key": "highlight_colour", "label": "Highlight colour", "type": "color", "default": [1.0, 1.0, 1.0, 1.0]},
  {"key": "highlight_opacity", "label": "Highlight", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.75},
  {"key": "shadow_colour", "label": "Shadow colour", "type": "color", "default": [0.0, 0.0, 0.0, 1.0]},
  {"key": "shadow_opacity", "label": "Shadow", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.6},
  {"key": "soften", "label": "Soften", "type": "float", "min": 0.0, "max": 20.0, "step": 0.1, "default": 1.5, "unit": " px"}
 ],
 "handles": [{"kind": "angle", "key": "light_angle"}],
 "passes": [
  {"shader": "res://effects/feather_matte/dist_across.gdshader", "set": {"reach_extra": 3.0}, "map": {"reach_a": "size", "reach_b": "soften"}},
  {"shader": "res://effects/feather_matte/dist_down.gdshader", "set": {"reach_extra": 3.0}, "map": {"reach_a": "size", "reach_b": "soften"}},
  {"shader": "combine.gdshader"}
 ]
}
