{
 "id": "audio_radial_lines",
 "label": "Radial Lines",
 "category": "Audio Reactive",
 "tags": [
  "audio",
  "music",
  "beat",
  "reactive",
  "visualiser"
 ],
 "version": 1,
 "blurb": "Lines that shoot out from a circle, longer where that slice of the sound is louder, with the circle swelling to the level. Drop a clip from the timeline, or a file from the bin or the Source monitor, on its Sound well.",
 "params": [
  {
   "key": "centre",
   "label": "Centre",
   "type": "vec2",
   "default": [
    0.5,
    0.5
   ]
  },
  {
   "key": "radius",
   "label": "Radius",
   "type": "float",
   "min": 0,
   "max": 0.6,
   "step": 0.005,
   "default": 0.15
  },
  {
   "key": "reach",
   "label": "Line length",
   "type": "float",
   "min": 0.01,
   "max": 0.6,
   "step": 0.005,
   "default": 0.2
  },
  {
   "key": "count",
   "label": "Lines",
   "type": "float",
   "min": 8,
   "max": 256,
   "step": 1,
   "default": 96
  },
  {
   "key": "thickness",
   "label": "Line width",
   "type": "float",
   "min": 0.5,
   "max": 40,
   "step": 0.5,
   "default": 3,
   "unit": " px"
  },
  {
   "key": "spin",
   "label": "Spin",
   "type": "float",
   "min": -2,
   "max": 2,
   "step": 0.01,
   "default": 0.0,
   "unit": " turns/s"
  },
  {
   "key": "pulse",
   "label": "Swell",
   "type": "float",
   "min": 0,
   "max": 1,
   "step": 0.01,
   "default": 0.15
  },
  {
   "key": "colour",
   "label": "Colour",
   "type": "color",
   "default": [
    1.0,
    0.45,
    0.75,
    1
   ]
  },
  {
   "key": "peak_colour",
   "label": "Peak colour",
   "type": "color",
   "default": [
    1,
    1,
    1,
    1
   ]
  },
  {
   "key": "opacity",
   "label": "Opacity",
   "type": "float",
   "min": 0,
   "max": 1,
   "step": 0.01,
   "default": 1
  }
 ],
 "passes": [
  {
   "shader": "res://effects/_audio_visual/visual.gdshader",
   "set": {
    "visual": 3
   }
  }
 ],
 "reactive": {
  "defaults": {
   "snd_attack": 5,
   "snd_release": 150,
   "snd_threshold": 2,
   "snd_bands": 2,
   "look_round": 1.0
  },
  "spectrum": {
   "uniform": "spec_tex",
   "bars": "count",
   "peaks_on": "peaks_on"
  },
  "level": "level",
  "look": true
 },
 "handles": [
  {
   "kind": "point",
   "key": "centre"
  },
  {
   "kind": "ring",
   "key": "radius",
   "about": "centre",
   "unit": "h",
   "feather": "reach"
  }
 ]
}
