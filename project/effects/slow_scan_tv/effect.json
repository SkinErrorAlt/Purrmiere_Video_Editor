  {"key": "mode", "label": "Mode", "type": "enum", "choices": ["Martin, colour by lines", "Robot, brightness and colour"], "default": 0},
  {"key": "lines", "label": "Lines", "type": "int", "min": 120, "max": 496, "step": 1, "default": 256},
  {"key": "slant", "label": "Slant", "type": "float", "min": -1.0, "max": 1.0, "step": 0.001, "default": 0.12},
  {"key": "signal", "label": "Signal strength", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.72},
  {"key": "fading", "label": "Fading", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.4},
  {"key": "carrier", "label": "Carrier whistle", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.25},
  {"key": "slips", "label": "Sync slips", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.3},
  {"key": "seed", "label": "Seed", "type": "int", "min": 0, "max": 9999, "step": 1, "default": 0}
 ],
