{
 "id": "rising_flood",
 "label": "Rising Flood",
 "category": "Stylize",
 "tags": [
  "look"
 ],
 "version": 1,
 "blurb": "Floods the picture as if it were a landscape that slopes down to the bottom of the frame, with the dark parts of the shot as hollows and the bright parts as high ground. Water comes in from the bottom and climbs, filling the low places that join up first, then pouring over each rim and filling the hollow behind it from the deepest part up, so separate pools appear, grow and merge into one sheet while bright things stand clear of it longest. The water soaks up the light with depth, darker and greener where it is deep, with the world above mirrored in it and broken up by ripples, the picture beneath bent by them, caustics in the shallows, glints, foam on the shoreline and a band of wet ground just above it. Key the level, or let it rise on its own over a set time.",
 "params": [
  {
   "key": "level",
   "label": "Water level",
   "type": "float",
   "min": 0.0,
   "max": 1.0,
   "step": 0.005,
   "default": 0.55
  },
  {
   "key": "rise_time",
   "label": "Rises over",
   "type": "float",
   "min": 0.0,
   "max": 60.0,
   "step": 0.1,
   "default": 6.0,
   "unit": " s"
  },
  {
