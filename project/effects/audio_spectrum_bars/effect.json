{
 "id": "audio_spectrum_bars",
 "label": "Spectrum Bars",
 "category": "Audio Reactive",
 "tags": [
  "audio",
  "music",
  "beat",
  "reactive",
  "visualiser"
 ],
 "version": 1,
 "blurb": "A bar for each slice of the sound, from the deepest bass on the left to the highest treble on the right. Drop a clip from the timeline, or a file from the bin or the Source monitor, on its Sound well.",
 "params": [
  {
   "key": "position",
   "label": "Position",
   "type": "vec2",
   "default": [
    0.5,
    0.92
   ]
  },
  {
   "key": "width",
   "label": "Width",
   "type": "float",
   "min": 0.05,
   "max": 1,
   "step": 0.01,
   "default": 0.7
  },
  {
   "key": "height",
   "label": "Height",
   "type": "float",
   "min": 0.01,
   "max": 1,
   "step": 0.01,
   "default": 0.35
  },
  {
   "key": "count",
   "label": "Bars",
   "type": "float",
   "min": 4,
   "max": 128,
   "step": 1,
   "default": 32
  },
  {
   "key": "gap",
   "label": "Gap",
   "type": "float",
   "min": 0,
   "max": 0.9,
   "step": 0.01,
   "default": 0.3
  },
  {
   "key": "mirror",
   "label": "Mirror up and down",
   "type": "bool",
   "default": false
  },
  {
   "key": "colour",
   "label": "Colour",
   "type": "color",
   "default": [
    1,
    1,
    1,
    1
   ]
  },
  {
   "key": "top_colour",
   "label": "Top colour",
   "type": "color",
   "default": [
    1.0,
    0.3,
    0.55,
    1
   ]
  },
  {
   "key": "peak_colour",
   "label": "Peak colour",
   "type": "color",
   "default": [
    1,
    1,
    1,
    1
   ]
  },
  {
   "key": "opacity",
   "label": "Opacity",
   "type": "float",
   "min": 0,
   "max": 1,
   "step": 0.01,
   "default": 1
  }
 ],
 "passes": [
  {
   "shader": "effect.gdshader"
  }
 ],
 "reactive": {
  "defaults": {
   "snd_attack": 5,
   "snd_release": 150,
   "snd_threshold": 2
  },
  "spectrum": {
   "uniform": "spec_tex",
   "bars": "count",
   "peaks_on": "peaks_on"
  },
  "look": true
 },
 "handles": [
  {
   "kind": "point",
   "key": "position"
  }
 ]
}
