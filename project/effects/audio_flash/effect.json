{
 "id": "audio_flash",
 "label": "Brightness Flash",
 "category": "Audio Reactive",
 "tags": [
  "audio",
  "music",
  "beat",
  "reactive",
  "visualiser"
 ],
 "version": 1,
 "blurb": "The picture flashes brighter on each hit and fades back over the beat decay. Drop a clip from the timeline, or a file from the bin or the Source monitor, on its Sound well.",
 "params": [
  {
   "key": "flash",
   "label": "Flash",
   "type": "float",
   "min": 0,
   "max": 1,
   "step": 0.01,
   "default": 0.35
  },
  {
   "key": "peak_contrast",
   "label": "Contrast at the hit",
   "type": "float",
   "min": 0,
   "max": 2,
   "step": 0.01,
   "default": 1.1
  }
 ],
 "passes": [
  {
   "shader": "res://effects/brightness_contrast/effect.gdshader"
  }
 ],
 "reactive": {
  "defaults": {
   "snd_mode": 1
  },
  "drive": {
   "brightness": {
    "rest": 0,
    "peak": "flash"
   },
   "contrast": {
    "rest": 1,
    "peak": "peak_contrast"
   }
  }
 }
}
