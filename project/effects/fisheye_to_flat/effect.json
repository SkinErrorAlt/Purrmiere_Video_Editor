{
 "id": "fisheye_to_flat",
 "label": "Fisheye to Flat",
 "category": "Distort",
 "tags": ["repair"],
 "version": 1,
 "blurb": "Straightens the curved lines of a fisheye or action camera lens by its real projection, so walls and horizons come out straight, or turns a flat picture into a fisheye to match one. Pick the lens type and its field of view across the width; Strength stops part way for a wide look with less bend. Unlike Lens Correction, which bends by a simple curve, this follows the lens maths, so it still works on a 180 degree lens.",
 "params": [
  {"key": "direction", "label": "Direction", "type": "enum", "choices": ["Fisheye to flat", "Flat to fisheye"], "default": 0},
  {"key": "projection", "label": "Lens type", "type": "enum", "choices": ["Equidistant (most action cameras)", "Equisolid (most fisheye lenses)", "Stereographic", "Orthographic"], "default": 0},
  {"key": "fov", "label": "Field of view across", "type": "float", "min": 60.0, "max": 220.0, "step": 0.5, "default": 130.0, "unit": " deg"},
  {"key": "strength", "label": "Strength", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 1.0},
  {"key": "zoom", "label": "Zoom", "type": "float", "min": 0.3, "max": 3.0, "step": 0.01, "default": 1.0},
  {"key": "centre", "label": "Lens centre", "type": "vec2", "default": [0.5, 0.5]},
  {"key": "outside", "label": "Outside the picture", "type": "enum", "choices": ["See through", "Stretch the edge"], "default": 0}
 ],
 "handles": [{"kind": "point", "key": "centre"}],
