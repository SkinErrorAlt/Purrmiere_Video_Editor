{
 "id": "blur_bokeh",
 "label": "Bokeh Blur",
 "category": "Blur & Sharpen",
 "version": 1,
 "blurb": "A disc convolution on a Vogel spiral with an iris shape and highlight boost. Anamorphic Squeeze stretches the discs into tall ovals like an anamorphic lens (below 1 makes wide ones), Cat's Eye clips them into lens shapes towards the corners the way a real lens vignettes, and Onion Rings adds the faint ring texture of aspherical elements to bright bokeh. Runs at half size above radius 12.",
 "params": [
  {"key": "radius", "label": "Radius", "type": "float", "min": 0, "max": 60, "step": 0.5, "default": 10},
  {"key": "iris_sides", "label": "Iris Sides", "type": "int", "min": 0, "max": 12, "step": 1, "default": 0},
  {"key": "iris_rotation", "label": "Iris Rotation", "type": "float", "min": -180, "max": 180, "step": 1, "default": 0, "unit": "deg"},
  {"key": "highlight", "label": "Highlight Boost", "type": "float", "min": 0, "max": 4, "step": 0.05, "default": 1.5},
  {"key": "edge", "label": "Repeat Edge Pixels", "type": "bool", "default": true},
  {"key": "squeeze", "label": "Anamorphic Squeeze", "type": "float", "min": 0.4, "max": 2.5, "step": 0.01, "default": 1},
  {"key": "cats_eye", "label": "Cat's Eye Towards Corners", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0},
  {"key": "onion", "label": "Onion Rings", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0}
 ],
 "passes": [
  {"shader": "bokeh.gdshader", "scale": 0.5, "when": {"param": "radius", "gt": 12}},
  {"shader": "res://effects/blur_gaussian/up.gdshader", "scale": 2.0, "when": {"param": "radius", "gt": 12}},
  {"shader": "bokeh.gdshader", "scale": 1.0, "when": {"param": "radius", "lte": 12}}
 ]
}
