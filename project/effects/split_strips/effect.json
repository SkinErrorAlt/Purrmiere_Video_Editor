{
 "id": "split_strips",
 "label": "Split Strips",
 "category": "Transform",
 "version": 1,
 "blurb": "Splits the frame into two to six strips, in rows or in columns, each showing the same view of the picture at its true shape: a crop that keeps the chosen centre in the middle, or the whole picture fitted inside. Add gaps in a colour, blur the outer strips (with three or more), mirror every other strip or turn every other one black and white.",
 "params": [
  {"key": "strips", "label": "Strips", "type": "int", "min": 2, "max": 6, "step": 1, "default": 3},
  {"key": "direction", "label": "Direction", "type": "enum", "choices": ["Rows", "Columns"], "default": 0},
  {"key": "content", "label": "Each strip shows", "type": "enum", "choices": ["Centre crop", "Whole picture fitted"], "default": 0},
  {"key": "gap", "label": "Gap width", "type": "float", "min": 0.0, "max": 200.0, "step": 0.5, "default": 8.0, "unit": " px"},
  {"key": "gap_colour", "label": "Gap colour", "type": "color", "default": [0.0, 0.0, 0.0, 1.0]},
  {"key": "blur", "label": "Blur the outer strips", "type": "float", "min": 0.0, "max": 120.0, "step": 0.5, "default": 0.0, "unit": " px"},
  {"key": "mirror", "label": "Mirror every other", "type": "bool", "default": false},
  {"key": "mono", "label": "Black and white every other", "type": "bool", "default": false},
  {"key": "centre", "label": "Crop centre", "type": "vec2", "default": [0.5, 0.5]}
 ],
 "handles": [{"kind": "point", "key": "centre"}],
 "passes": [
  {"shader": "res://effects/glow/down13.gdshader", "scale": 0.5},
  {"shader": "res://effects/glow/down13.gdshader", "scale": 0.5},
  {"shader": "res://effects/glow/down13.gdshader", "scale": 0.5},
  {"shader": "res://effects/glow/down13.gdshader", "scale": 0.5},
  {"shader": "res://effects/glow/down13.gdshader", "scale": 0.5},
  {"shader": "effect.gdshader", "scale": 32.0, "inputs": {"blur1": 0, "blur2": 1, "blur3": 2, "blur4": 3, "blur5": 4}}
 ]
}
