{
 "id": "whip_pan",
 "label": "Whip Pan",
 "category": "Transform",
 "version": 1,
 "blurb": "A camera whip at a cut: put it on both clips and the first one whips away at its end while the next one whips in at its start, with heavy motion blur hiding the cut. The picture wraps round so no gap shows. Use Progress to key it by hand instead.",
 "params": [
  {"key": "when", "label": "When", "type": "enum", "choices": ["In at the start and out at the end", "In at the start", "Out at the end", "By Progress"], "default": 0},
  {"key": "duration", "label": "Whip length", "type": "float", "min": 0.05, "max": 2.0, "step": 0.01, "default": 0.3, "unit": " s"},
  {"key": "direction", "label": "Direction", "type": "enum", "choices": ["Left", "Right", "Up", "Down", "Spin clockwise", "Spin anticlockwise"], "default": 0},
  {"key": "progress", "label": "Progress", "type": "float", "min": 0.0, "max": 1.0, "step": 0.005, "default": 0.0},
  {"key": "distance", "label": "Travel", "type": "float", "min": 0.25, "max": 4.0, "step": 0.05, "default": 1.5},
  {"key": "blur", "label": "Motion blur", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.8},
  {"key": "edges", "label": "Wrap", "type": "enum", "choices": ["Mirror", "Repeat"], "default": 0}
 ],
 "passes": [
  {"shader": "whip.gdshader", "set": {"stage": 0}},
  {"shader": "whip.gdshader", "set": {"stage": 1}}
 ]
}
