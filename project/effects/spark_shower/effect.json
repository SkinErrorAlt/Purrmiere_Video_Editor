{
 "id": "spark_shower",
 "label": "Spark Shower",
 "category": "Generate",
 "tags": ["light"],
 "version": 1,
 "blurb": "Hot sparks spraying from a point, as from a grinder, a welder or a sparkler. Each spark is a motion blurred streak that flies out, slows in the air, falls under gravity and skips off the floor, losing energy with every bounce, and cools from white through yellow and orange to a dull red as it slows. The contact point glows and flickers and lights what is near it. Set the floor below the frame to let the sparks fall away.",
 "params": [
  {"key": "source", "label": "Source", "type": "vec2", "default": [0.32, 0.55]},
  {"key": "angle", "label": "Direction", "type": "float", "min": -180.0, "max": 180.0, "step": 0.5, "default": -35.0, "unit": " deg"},
  {"key": "spread", "label": "Spread", "type": "float", "min": 0.0, "max": 180.0, "step": 0.5, "default": 40.0, "unit": " deg"},
  {"key": "rate", "label": "Sparks per second", "type": "float", "min": 0.1, "max": 600.0, "step": 0.1, "default": 320.0},
  {"key": "speed", "label": "Speed", "type": "float", "min": 20.0, "max": 4000.0, "step": 1.0, "default": 1100.0, "unit": " px"},
  {"key": "gravity", "label": "Gravity", "type": "float", "min": 0.0, "max": 5000.0, "step": 1.0, "default": 1700.0, "unit": " px"},
  {"key": "drag", "label": "Air drag", "type": "float", "min": 0.0, "max": 8.0, "step": 0.01, "default": 1.8},
  {"key": "life", "label": "Spark life", "type": "float", "min": 0.1, "max": 4.0, "step": 0.01, "default": 1.1, "unit": " s"},
  {"key": "floor_y", "label": "Floor height", "type": "float", "min": 0.0, "max": 1.5, "step": 0.005, "default": 0.88},
  {"key": "bounce", "label": "Bounce", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.35},
  {"key": "streak", "label": "Streak length", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.6},
  {"key": "colour", "label": "Colour", "type": "color", "default": [1.0, 0.45, 0.08, 1.0]},
  {"key": "glow", "label": "Glow", "type": "float", "min": 0.0, "max": 3.0, "step": 0.01, "default": 1.0},
  {"key": "blend", "label": "How it mixes", "type": "enum", "choices": ["Add", "Screen", "Lighten", "Replace"], "default": 0},
  {"key": "seed", "label": "Seed", "type": "int", "min": 0, "max": 9999, "step": 1, "default": 0}
 ],
 "handles": [{"kind": "point", "key": "source"}, {"kind": "angle", "key": "angle", "about": "source", "zero": "right", "turn": "cw"}, {"kind": "band", "key": "floor_y"}],
 "passes": [
  {"shader": "mask.gdshader", "scale": 0.125},
  {"shader": "sparks.gdshader", "scale": 8.0},
  {"shader": "res://effects/fireworks/down.gdshader", "scale": 0.5, "set": {"gain": 3.0}},
  {"shader": "res://effects/fireworks/down.gdshader", "scale": 0.5},
  {"shader": "res://effects/fireworks/down.gdshader", "scale": 0.5},
  {"shader": "res://effects/fireworks/down.gdshader", "scale": 0.5},
  {"shader": "res://effects/fireworks/up.gdshader", "scale": 2.0, "inputs": {"level_tex": 4}},
  {"shader": "res://effects/fireworks/up.gdshader", "scale": 2.0, "inputs": {"level_tex": 3}},
  {"shader": "res://effects/fireworks/up.gdshader", "scale": 2.0, "inputs": {"level_tex": 2}},
  {"shader": "mix.gdshader", "scale": 2.0, "inputs": {"sparks_tex": 1}}
 ]
}
