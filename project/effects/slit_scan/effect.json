  {"key": "direction", "label": "Now starts at", "type": "enum", "choices": ["Top", "Bottom", "Left", "Right", "Centre", "Edges", "An angle"], "default": 0},
  {"key": "angle", "label": "Angle", "type": "float", "min": -180, "max": 180, "step": 1, "default": 30, "unit": " deg"},
  {"key": "bands", "label": "Bands", "type": "int", "min": 0, "max": 64, "step": 1, "default": 0},
  {"key": "curve", "label": "Time curve", "type": "float", "min": 0.25, "max": 4.0, "step": 0.05, "default": 1.0},
  {"key": "centre", "label": "Centre", "type": "vec2", "default": [0.5, 0.5]}
 ],
 "passes": [{"shader": "effect.gdshader"}]
}
