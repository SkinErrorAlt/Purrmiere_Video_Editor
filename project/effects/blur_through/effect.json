{
 "id": "blur_through",
 "label": "Blur Through",
 "category": "Transition",
 "version": 1,
 "blurb": "The cross blur: put it on both clips of a cut and the first one melts into a soft blur right up to the cut while the next one comes back into focus out of the same blur, so the change of shot is lost in the softness. Glow lets the bright parts bloom as it blurs; Brighten lifts the blur towards white. Use Progress to key it by hand.",
 "params": [
  {"key": "when", "label": "When", "type": "enum", "choices": ["In at the start and out at the end", "In at the start", "Out at the end", "By Progress"], "default": 0},
  {"key": "duration", "label": "Blur length", "type": "float", "min": 0.05, "max": 3.0, "step": 0.01, "default": 0.5, "unit": " s"},
  {"key": "progress", "label": "Progress", "type": "float", "min": 0.0, "max": 1.0, "step": 0.005, "default": 0.0},
  {"key": "amount", "label": "Blur", "type": "float", "min": 0.05, "max": 1.0, "step": 0.01, "default": 0.6},
  {"key": "glow", "label": "Glow", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.35},
  {"key": "brighten", "label": "Brighten", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.0}
 ],
 "passes": [
  {"shader": "res://effects/glow/down13.gdshader", "scale": 0.5},
  {"shader": "res://effects/glow/down13.gdshader", "scale": 0.5},
  {"shader": "res://effects/glow/down13.gdshader", "scale": 0.5},
  {"shader": "res://effects/glow/down13.gdshader", "scale": 0.5},
  {"shader": "res://effects/glow/down13.gdshader", "scale": 0.5},
  {"shader": "mix.gdshader", "scale": 32.0, "inputs": {"level_1": 0, "level_2": 1, "level_3": 2, "level_4": 3}}
 ]
}
