  {"key": "focus", "label": "Focus distance", "type": "float", "min": 0, "max": 1, "step": 0.005, "default": 0.5},
  {"key": "focus_range", "label": "Sharp band", "type": "float", "min": 0, "max": 1, "step": 0.005, "default": 0.15},
  {"key": "max_blur", "label": "Maximum blur", "type": "float", "min": 0, "max": 60, "step": 0.1, "default": 14, "unit": " px"},
  {"key": "centre", "label": "Focus point", "type": "vec2", "default": [0.5, 0.5]},
