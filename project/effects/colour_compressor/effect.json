{
 "id": "colour_compressor",
 "label": "Colour Compressor",
 "category": "Colour Correction",
 "version": 1,
 "blurb": "Pulls a range of hues together so they read as one colour: blotchy, red and yellow patches of skin even out onto the skin tone line of the vectorscope, or mixed greens of foliage become one green. Even out saturation brings the strong and weak colours in the range towards their average. Greys and colours outside the range are left alone.",
 "params": [
  {"key": "target", "label": "Pull towards", "type": "enum", "choices": ["The skin tone line", "The centre colour"], "default": 0},
  {"key": "centre", "label": "Centre colour", "type": "color", "default": [0.35, 0.6, 0.25, 1.0]},
  {"key": "width", "label": "Hue range", "type": "float", "min": 5.0, "max": 180.0, "step": 1.0, "default": 50.0, "unit": " deg"},
  {"key": "softness", "label": "Softness", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.5},
  {"key": "hue_pull", "label": "Pull hues together", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.5},
  {"key": "sat_pull", "label": "Even out saturation", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.3},
  {"key": "show_mask", "label": "Show mask", "type": "bool", "default": false}
 ],
 "passes": [
  {"shader": "stats.gdshader", "scale": 0.03125},
  {"shader": "combine.gdshader", "scale": 1.0},
  {"shader": "apply.gdshader", "scale": 32.0}
 ]
}
