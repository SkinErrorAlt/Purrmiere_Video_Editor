{
 "id": "blur_fill",
 "label": "Blurred Fill",
 "category": "Transform",
 "version": 1,
 "canvas": "frame",
 "canvas_picture": {"size": "size", "at": "position"},
 "blurb": "Fills the whole frame round a clip of another shape with a blurred, darkened and zoomed copy of itself: the look for vertical Shorts cut from wide gameplay, and for tall phone clips in a wide video. It draws over the whole frame, not only inside the clip, so leave the clip at its fitted size and move the sharp picture with Picture size and Picture at. The fill can also be mirrored edges, stretched edges, a colour or nothing.",
 "params": [
  {"key": "fill", "label": "Fill with", "type": "enum", "choices": ["Blurred copy", "Mirrored edges", "Stretched edges", "Colour", "See through"], "default": 0},
  {"key": "blur", "label": "Blur", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.9},
  {"key": "zoom", "label": "Fill zoom", "type": "float", "min": 1.0, "max": 3.0, "step": 0.01, "default": 1.1},
  {"key": "darken", "label": "Darken the fill", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.3},
  {"key": "fill_saturation", "label": "Fill colour strength", "type": "float", "min": 0.0, "max": 2.0, "step": 0.01, "default": 1.1},
  {"key": "colour", "label": "Colour", "type": "color", "default": [0.07, 0.07, 0.09, 1.0]},
  {"key": "size", "label": "Picture size", "type": "float", "min": 0.2, "max": 2.0, "step": 0.005, "default": 1.0},
  {"key": "position", "label": "Picture at", "type": "vec2", "default": [0.5, 0.5]},
  {"key": "corner", "label": "Round corners", "type": "float", "min": 0.0, "max": 0.5, "step": 0.005, "default": 0.0},
  {"key": "shadow", "label": "Shadow", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.4},
  {"key": "border", "label": "Border", "type": "float", "min": 0.0, "max": 0.05, "step": 0.0005, "default": 0.0},
  {"key": "border_colour", "label": "Border colour", "type": "color", "default": [1.0, 1.0, 1.0, 1.0]}
 ],
 "handles": [{"kind": "point", "key": "position"}],
 "passes": [
  {"shader": "fill_base.gdshader", "scale": 0.25, "when": {"param": "fill", "lt": 3}},
  {"shader": "res://effects/glow/down13.gdshader", "scale": 0.5, "when": {"param": "fill", "lt": 3}},
  {"shader": "res://effects/glow/down13.gdshader", "scale": 0.5, "when": {"param": "fill", "lt": 3}},
  {"shader": "res://effects/glow/down13.gdshader", "scale": 0.5, "when": {"param": "fill", "lt": 3}},
  {"shader": "wide9.gdshader", "scale": 1.0, "set": {"direction": [1.0, 0.0]}, "when": {"param": "fill", "lt": 3}},
  {"shader": "wide9.gdshader", "scale": 1.0, "set": {"direction": [0.0, 1.0]}, "when": {"param": "fill", "lt": 3}},
  {"shader": "fill_mix.gdshader", "scale": 32.0, "inputs": {"eighth_tex": 1, "sixteenth_tex": 2, "last_tex": 5}}
 ]
}
