  {"key": "bend", "label": "Bend", "type": "float", "min": -360.0, "max": 360.0, "step": 0.5, "default": 40.0, "unit": " deg"},
  {"key": "edges", "label": "Edges", "type": "enum", "choices": ["Stretch the edge", "Mirror", "Transparent"], "default": 2}
 ],
 "handles": [{"kind": "line", "keys": ["start", "end"]}],
 "passes": "single"
}
