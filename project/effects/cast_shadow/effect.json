{
 "id": "cast_shadow",
 "label": "Cast Shadow",
 "category": "Light & Shadow",
 "version": 1,
 "blurb": "Lays the shadow of a keyed or cut out subject on the floor behind it, the way a light in front casts it: the shadow starts at the feet, stretches away in a direction you choose, gets softer and fainter the further it goes, with a darker contact shadow where the subject touches the ground. Put the floor point on the monitor at the feet and drag the direction handle. Drop Shadow only offsets a flat copy.",
 "params": [
  {"key": "base", "label": "Floor point", "type": "vec2", "default": [0.5, 0.92]},
  {"key": "angle", "label": "Direction", "type": "float", "min": -180.0, "max": 180.0, "step": 1.0, "default": -35.0, "unit": "deg"},
  {"key": "length_scale", "label": "Length", "type": "float", "min": 0.0, "max": 3.0, "step": 0.01, "default": 0.6},
  {"key": "opacity", "label": "Opacity", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.6},
  {"key": "colour", "label": "Colour", "type": "color", "default": [0.0, 0.0, 0.0, 1.0]},
  {"key": "softness_near", "label": "Softness at the feet", "type": "float", "min": 0.0, "max": 50.0, "step": 0.1, "default": 2.0, "unit": " px"},
  {"key": "softness_far", "label": "Softness far away", "type": "float", "min": 0.0, "max": 150.0, "step": 0.1, "default": 30.0, "unit": " px"},
  {"key": "fade", "label": "Fade with distance", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.7},
  {"key": "contact", "label": "Contact shadow", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.5},
  {"key": "shadow_only", "label": "Shadow only", "type": "bool", "default": false}
 ],
 "handles": [{"kind": "point", "key": "base"}, {"kind": "angle", "key": "angle", "about": "base"}],
 "passes": "single"
}
