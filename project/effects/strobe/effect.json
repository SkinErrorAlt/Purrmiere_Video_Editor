{
 "id": "strobe",
 "label": "Strobe",
 "category": "Stylize",
 "version": 1,
 "blurb": "Flashes the picture on a steady beat: a colour, an inverted frame, a black frame or a gap you can see through.",
 "params": [
  {"key": "period", "label": "Time between flashes", "type": "float", "min": 0.02, "max": 10.0, "step": 0.01, "default": 0.5, "unit": " s"},
  {"key": "duration", "label": "Flash length", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.2},
  {"key": "mode", "label": "Flash", "type": "enum", "choices": ["Colour flash", "Invert", "Transparent", "Black"], "default": 0},
  {"key": "colour", "label": "Colour", "type": "color", "default": [1.0, 1.0, 1.0, 0.85]},
  {"key": "fade", "label": "Fade in and out", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.3},
  {"key": "random", "label": "Skip some flashes", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.0},
  {"key": "seed", "label": "Seed", "type": "int", "min": 0, "max": 9999, "step": 1, "default": 0}
 ],
 "passes": "single"
}
