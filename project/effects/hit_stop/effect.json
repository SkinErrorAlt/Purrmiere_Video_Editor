{
 "id": "hit_stop",
 "label": "Hit Stop",
 "category": "Time",
 "tags": ["look"],
 "version": 1,
 "blurb": "The freeze fighting games use to make a blow land, found and played by itself: whenever the footage suddenly jolts, a hit, an explosion, a crash, a fast swing into frame, the picture holds on that exact frame for a split second with a small punch in, then plays fast until it has caught up again, so nothing is cut and the clip stays in sync with its sound. The frame recoils away from where the hit was as it lets go.",
 "history": {"max": 40},
 "params": [
  {"key": "hold", "label": "Freeze for", "type": "float", "min": 0.03, "max": 0.3, "step": 0.01, "default": 0.13, "unit": " s"},
  {"key": "catch_up", "label": "Catch up speed", "type": "float", "min": 1.5, "max": 4.0, "step": 0.1, "default": 2.0, "unit": " x"},
  {"key": "punch", "label": "Punch in", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.5},
  {"key": "shake", "label": "Recoil", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.5},
  {"key": "sensitivity", "label": "Hit sensitivity", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.5}
 ],
 "passes": [
  {"shader": "res://effects/_events/thumbs.gdshader", "scale": 0.125},
  {"shader": "res://effects/_events/stats_change.gdshader", "scale": 0.25},
  {"shader": "res://effects/_events/stats_motion.gdshader", "scale": 1.0, "inputs": {"thumb_tex": 0}},
  {"shader": "res://effects/_events/track_motion.gdshader", "scale": 1.0, "inputs": {"change_tex": 1, "motion_tex": 2}, "set": {"mode": 1, "look_back": 0.95, "refractory": 0.6}},
  {"shader": "apply.gdshader", "scale": 32.0}
 ]
}
