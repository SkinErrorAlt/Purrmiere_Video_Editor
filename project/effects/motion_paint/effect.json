{
 "id": "motion_paint",
 "label": "Painted Motion",
 "category": "Time",
 "tags": [
  "look"
 ],
 "version": 1,
 "blurb": "Turns the clip into a moving oil painting where the brushwork follows the movement. Still things are painted in short strokes that follow their shapes, and everything that moves is painted in long sweeping strokes laid along the way it is going, longer the faster it goes, with the paint dragged out behind it like a wet brush pulled across the canvas. A runner becomes a streak of strokes pointing back along the run, a swinging arm leaves a fan of strokes and the still street stays calm, like an impressionist painting that knows what is moving.",
 "history": {
  "max": 1
 },
