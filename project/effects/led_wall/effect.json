{
 "id": "led_wall",
 "label": "LED Video Wall",
 "category": "Stylize",
 "tags": ["look", "light"],
 "version": 1,
 "blurb": "Shows the picture on a giant LED screen: every pixel a cluster of red, green and blue diodes in a black face, a little uneven from diode to diode and tile to tile, glowing into the gaps, with the colour moire a camera picks up as you pull back.",
 "params": [
  {"key": "pitch", "label": "LED pitch", "type": "float", "min": 3.0, "max": 60.0, "step": 0.1, "default": 10.0, "unit": " px"},
  {"key": "view_distance", "label": "Viewing distance", "type": "float", "min": 1.0, "max": 12.0, "step": 0.01, "default": 1.0},
  {"key": "diode_type", "label": "Diodes", "type": "enum", "choices": ["Indoor SMD", "Outdoor lamps"], "default": 0},
  {"key": "diode_size", "label": "Diode size", "type": "float", "min": 0.3, "max": 1.0, "step": 0.01, "default": 0.62},
  {"key": "brightness", "label": "Brightness", "type": "float", "min": 0.3, "max": 3.0, "step": 0.01, "default": 1.85},
  {"key": "bloom", "label": "Bloom", "type": "float", "min": 0.0, "max": 2.0, "step": 0.01, "default": 0.45},
  {"key": "unevenness", "label": "Unevenness", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.35},
  {"key": "module_size", "label": "Tile size", "type": "int", "min": 4, "max": 128, "step": 1, "default": 32},
  {"key": "room_light", "label": "Room light", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.12},
  {"key": "moire", "label": "Camera moire", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 1.0},
  {"key": "wall_angle", "label": "Wall angle", "type": "float", "min": -10.0, "max": 10.0, "step": 0.01, "default": 0.35, "unit": " deg"},
  {"key": "refresh", "label": "Refresh bands", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.0},
  {"key": "band_speed", "label": "Band speed", "type": "float", "min": -4.0, "max": 4.0, "step": 0.01, "default": 0.5},
  {"key": "seed", "label": "Seed", "type": "int", "min": 0, "max": 9999, "step": 1, "default": 0}
 ],
 "passes": [
  {"shader": "led.gdshader"},
  {"shader": "res://effects/glow/down13.gdshader", "scale": 0.5},
  {"shader": "res://effects/glow/down13.gdshader", "scale": 0.5},
  {"shader": "res://effects/glow/down13.gdshader", "scale": 0.5},
  {"shader": "res://effects/glow/down13.gdshader", "scale": 0.5},
  {"shader": "res://effects/glow/up_tent.gdshader", "scale": 2.0, "inputs": {"level_tex": 3}},
  {"shader": "res://effects/glow/up_tent.gdshader", "scale": 2.0, "inputs": {"level_tex": 2}},
  {"shader": "mix.gdshader", "scale": 4.0, "inputs": {"led_tex": 0}}
 ]
}
