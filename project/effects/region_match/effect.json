{
 "id": "region_match",
 "label": "Match Regions",
 "category": "Colour Correction",
 "tags": ["repair"],
 "version": 1,
 "blurb": "Makes one part of the frame match another part of the same frame: two webcams side by side in a call recording, the two players of a split screen, a face cam boxed into a game, a second camera angle laid in a corner. Put the reference box on the part that looks right and the target box on the part that does not; every frame it measures both in a perceptual colour space and moves the target's brightness, contrast and colour onto the reference, with a soft edge so nothing outside moves. No reference picture is needed, so it keeps matching while both change.",
 "params": [
  {"key": "ref_centre", "label": "Reference centre", "type": "vec2", "default": [0.25, 0.5]},
  {"key": "ref_width", "label": "Reference width", "type": "float", "min": 0.02, "max": 1.0, "step": 0.005, "default": 0.46},
  {"key": "ref_height", "label": "Reference height", "type": "float", "min": 0.02, "max": 1.0, "step": 0.005, "default": 0.9},
  {"key": "target_centre", "label": "Target centre", "type": "vec2", "default": [0.75, 0.5]},
  {"key": "target_width", "label": "Target width", "type": "float", "min": 0.02, "max": 1.0, "step": 0.005, "default": 0.5},
  {"key": "target_height", "label": "Target height", "type": "float", "min": 0.02, "max": 1.0, "step": 0.005, "default": 1.0},
  {"key": "feather", "label": "Soft edge", "type": "float", "min": 0.0, "max": 0.2, "step": 0.001, "default": 0.0},
  {"key": "apply_to", "label": "Correct", "type": "enum", "choices": ["Inside the target box", "Everything outside the reference box"], "default": 0},
  {"key": "match_brightness", "label": "Match brightness", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 1.0},
  {"key": "match_contrast", "label": "Match contrast", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 1.0},
  {"key": "match_colour", "label": "Match colour", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 1.0}
 ],
 "handles": [
  {"kind": "point", "key": "ref_centre"},
  {"kind": "ring", "key": "ref_width", "key_y": "ref_height", "about": "ref_centre", "unit": "uv", "scale": 2.0, "shape": "box"},
  {"kind": "point", "key": "target_centre"},
  {"kind": "ring", "key": "target_width", "key_y": "target_height", "about": "target_centre", "unit": "uv", "scale": 2.0, "shape": "box"}
 ],
 "passes": [
  {"shader": "stats.gdshader", "scale": 0.03125, "set": {"from_ref": false, "second": false}},
  {"shader": "stats.gdshader", "scale": 1.0, "set": {"from_ref": false, "second": true}, "inputs": {"mean_tex": 0}},
  {"shader": "stats.gdshader", "scale": 1.0, "set": {"from_ref": true, "second": false}},
  {"shader": "stats.gdshader", "scale": 1.0, "set": {"from_ref": true, "second": true}, "inputs": {"mean_tex": 2}},
  {"shader": "res://effects/colour_match/combine.gdshader", "scale": 1.0, "inputs": {"src_mean": 0, "src_spread": 1, "ref_mean": 2, "ref_spread": 3}},
  {"shader": "apply.gdshader", "scale": 32.0}
 ]
}
