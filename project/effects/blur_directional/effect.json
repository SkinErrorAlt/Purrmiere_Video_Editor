{
 "id": "blur_directional",
 "label": "Directional Blur",
 "category": "Blur & Sharpen",
 "version": 1,
 "blurb": "A blur along one direction, centred on the pixel. Long lengths run a second comb pass so taps stay dense.",
 "params": [
  {"key": "angle", "label": "Direction", "type": "float", "min": -180, "max": 180, "step": 1, "default": 0, "unit": "deg"},
  {"key": "length", "label": "Blur Length", "type": "float", "min": 0, "max": 200, "step": 0.1, "default": 8},
  {"key": "kernel", "label": "Kernel", "type": "enum", "choices": ["Smooth", "Flat", "Soft"], "default": 0},
  {"key": "edge", "label": "Repeat Edge Pixels", "type": "bool", "default": true}
 ],
 "handles": [{"kind": "angle", "key": "angle", "zero": "right", "turn": "cw", "length": "length", "length_unit": "px"}],
 "passes": [
  {"shader": "line.gdshader", "set": {"stage": 0}},
  {"shader": "line.gdshader", "set": {"stage": 1}, "when": {"param": "length", "gt": 48}}
 ]
}
