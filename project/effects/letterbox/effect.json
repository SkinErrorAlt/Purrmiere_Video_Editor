 "params": [
  {"key": "aspect", "label": "Aspect ratio", "type": "enum", "choices": ["2.39:1", "2.35:1", "2.00:1", "1.85:1", "1.66:1", "4:3", "1:1", "4:5", "9:16", "Custom"], "default": 0},
  {"key": "custom_aspect", "label": "Custom ratio", "type": "float", "min": 0.2, "max": 5, "step": 0.01, "default": 2},
  {"key": "colour", "label": "Colour", "type": "color", "default": [0.0, 0.0, 0.0, 1.0]},
  {"key": "softness", "label": "Softness", "type": "float", "min": 0, "max": 200, "step": 0.5, "default": 0, "unit": " px"},
  {"key": "offset", "label": "Offset", "type": "float", "min": -1, "max": 1, "step": 0.01, "default": 0},
  {"key": "amount", "label": "Amount", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 1},
  {"key": "transparent", "label": "Cut to transparent", "type": "bool", "default": false}
 ],
 "passes": [
  {"shader": "bars.gdshader"}
 ]
}
