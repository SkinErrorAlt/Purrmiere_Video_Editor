{
 "id": "line_integral",
 "label": "Line Integral",
 "category": "Stylize",
 "version": 1,
 "blurb": "Draws swirling brush strokes that follow the shapes in the picture, like a Van Gogh painting. The strokes run along the edges or across them, and can smear fine grain or the picture itself.",
 "params": [
  {"key": "smear", "label": "Strokes made of", "type": "enum", "choices": ["Grain", "The picture"], "default": 0},
  {"key": "direction", "label": "Strokes run", "type": "enum", "choices": ["Along the edges", "Across the edges"], "default": 0},
  {"key": "stroke_length", "label": "Stroke length", "type": "float", "min": 1.0, "max": 200.0, "step": 0.5, "default": 16.0, "unit": " px"},
  {"key": "grain", "label": "Grain size", "type": "float", "min": 0.5, "max": 10.0, "step": 0.1, "default": 1.5, "unit": " px"},
  {"key": "strength", "label": "Strength", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.7},
  {"key": "flat_angle", "label": "Stroke angle where flat", "type": "float", "min": -180.0, "max": 180.0, "step": 1.0, "default": 45.0, "unit": " deg"},
  {"key": "seed", "label": "Seed", "type": "int", "min": 0, "max": 9999, "step": 1, "default": 0}
 ],
 "handles": [{"kind": "angle", "key": "flat_angle", "zero": "right", "turn": "cw"}],
 "passes": [
  {"shader": "field.gdshader", "scale": 0.25},
  {"shader": "smooth.gdshader", "scale": 1.0},
  {"shader": "lic.gdshader", "scale": 4.0}
 ]
}
