{
 "id": "thermal_camera",
 "label": "Thermal Camera",
 "category": "Stylize",
 "tags": ["look"],
 "version": 1,
 "blurb": "Footage from a real infrared camera: people and lights run hot, sky and leaves run cold, the low sensor resolution softens everything, hot things bloom, the edges of the visible picture are blended in the way FLIR does it, and the faint column stripes of the sensor creep back between shutter clicks. Ironbow, white hot, black hot, rainbow, lava and arctic palettes.",
 "params": [
  {"key": "palette", "label": "Palette", "type": "enum", "choices": ["Ironbow", "White hot", "Black hot", "Rainbow", "Lava", "Arctic"], "default": 0},
  {"key": "auto_range", "label": "Auto range", "type": "bool", "default": true},
  {"key": "level", "label": "Level", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.5},
  {"key": "span", "label": "Span", "type": "float", "min": 0.1, "max": 1.5, "step": 0.01, "default": 0.8},
  {"key": "body_heat", "label": "Body heat", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.7},
  {"key": "sky_cold", "label": "Cold sky", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.7},
  {"key": "sensor", "label": "Sensor width", "type": "int", "min": 80, "max": 640, "step": 1, "default": 320},
  {"key": "bloom", "label": "Heat bloom", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.4},
  {"key": "msx", "label": "Edge detail", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.4},
  {"key": "noise", "label": "Noise", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.3},
  {"key": "stripes", "label": "Column stripes", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.45},
  {"key": "shutter", "label": "Shutter every", "type": "float", "min": 0.0, "max": 30.0, "step": 0.1, "default": 8.0, "unit": " s"},
  {"key": "seed", "label": "Seed", "type": "int", "min": 0, "max": 9999, "step": 1, "default": 0}
 ],
 "passes": [
  {"shader": "heat.gdshader"},
  {"shader": "res://effects/glow/down13.gdshader", "scale": 0.5},
  {"shader": "res://effects/glow/down13.gdshader", "scale": 0.5},
  {"shader": "res://effects/glow/down13.gdshader", "scale": 0.5},
  {"shader": "res://effects/glow/down13.gdshader", "scale": 0.5},
  {"shader": "res://effects/glow/down13.gdshader", "scale": 0.5},
  {"shader": "res://effects/glow/down13.gdshader", "scale": 0.5},
  {"shader": "res://effects/glow/down13.gdshader", "scale": 0.5},
  {"shader": "camera.gdshader", "scale": 128.0, "inputs": {"heat_tex": 0, "half_tex": 1, "quarter_tex": 2, "bloom_tex": 3}}
 ]
}
