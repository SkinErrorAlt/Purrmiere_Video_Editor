{
 "id": "snd_impact_shock",
 "label": "Impact Shock",
 "category": "Audio Reactive",
 "tags": ["audio", "reactive", "impact", "distort"],
 "version": 1,
 "blurb": "Every hit in the sound sends a pressure wave through the air of the shot, bending the picture as it passes like the shock off an explosion. Each wave takes its shape from what that hit sounded like: a deep boom rolls out wide, slow and heavy, a sharp crack or snap flicks out thin and fast with a faint colour split, and several hits overlap as rings travelling at once.",
 "params": [
  {"key": "strength", "label": "Strength", "type": "float", "min": 0.0, "max": 80.0, "step": 0.5, "default": 34.0, "unit": " px"},
  {"key": "speed", "label": "Speed", "type": "float", "min": 0.2, "max": 4.0, "step": 0.01, "default": 1.3},
  {"key": "min_hit", "label": "Hits that shock", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.3},
  {"key": "scatter", "label": "Scatter", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.3},
  {"key": "fringe", "label": "Colour split", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.4},
  {"key": "life", "label": "Wave life", "type": "float", "min": 0.2, "max": 3.0, "step": 0.01, "default": 1.1, "unit": " s"},
  {"key": "centre", "label": "Centre", "type": "vec2", "default": [0.5, 0.5]}
 ],
 "passes": [{"shader": "effect.gdshader"}],
 "reactive": {"listen": {"hits": 16}, "defaults": {"snd_threshold": 5.0}},
 "handles": [{"kind": "point", "key": "centre"}]
}
