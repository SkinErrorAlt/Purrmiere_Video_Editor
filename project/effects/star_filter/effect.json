{
 "id": "star_filter",
 "label": "Star Filter",
 "category": "Light & Shadow",
 "tags": ["light"],
 "version": 1,
 "blurb": "A cross screen lens filter: every highlight, lamp or sun glint throws a four, six or eight pointed star with long fading points and a touch of rainbow. Turn the Angle to spin the stars.",
 "params": [
  {"key": "threshold", "label": "Brightness needed", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.8},
  {"key": "points", "label": "Points", "type": "enum", "choices": ["Four", "Six", "Eight"], "default": 0},
  {"key": "star_length", "label": "Length", "type": "float", "min": 10.0, "max": 800.0, "step": 1.0, "default": 180.0, "unit": " px"},
  {"key": "angle", "label": "Angle", "type": "float", "min": -180.0, "max": 180.0, "step": 1.0, "default": 45.0, "unit": " deg"},
  {"key": "intensity", "label": "Intensity", "type": "float", "min": 0.0, "max": 4.0, "step": 0.01, "default": 1.0},
  {"key": "rainbow", "label": "Rainbow", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.3},
  {"key": "tint", "label": "Tint", "type": "color", "default": [1.0, 0.97, 0.9, 1.0]},
  {"key": "stars_only", "label": "Stars only", "type": "bool", "default": false}
 ],
 "handles": [{"kind": "angle", "key": "angle", "length": "star_length"}],
 "passes": [
  {"shader": "res://effects/glow/bright.gdshader", "scale": 0.5, "set": {"knee": 0.2}},
  {"shader": "res://effects/glow/down13.gdshader", "scale": 0.5},
  {"shader": "star.gdshader"},
  {"shader": "star_mix.gdshader", "scale": 4.0}
 ]
}
