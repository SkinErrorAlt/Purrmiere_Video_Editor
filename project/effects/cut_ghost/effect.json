{
 "id": "cut_ghost",
 "label": "Last Shot Lingers",
 "category": "Time",
 "tags": ["look"],
 "version": 1,
 "blurb": "Finds every cut inside the clip and lets the last frame of the shot before it hang on for a moment over the new shot, like an image burnt into the back of your eye. The bright parts of the old shot hold on longest while its darks let go first, and the ghost drifts and softens as it fades. Whole shot dissolves the old picture away instead, turning hard cuts into a short tail. No keyframes and no splitting: put it on a whole edit or a nested sequence.",
 "history": {"max": 62, "reach": ["linger", 1.12], "seconds": ["linger"]},
 "params": [
  {"key": "lingers", "label": "What lingers", "type": "enum", "choices": ["Bright parts", "Whole shot"], "default": 0},
  {"key": "linger", "label": "Lingers for", "type": "float", "min": 0.2, "max": 1.8, "step": 0.01, "default": 1.2, "unit": " s"},
  {"key": "strength", "label": "Strength", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.85},
  {"key": "drift", "label": "Drift", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.4},
  {"key": "soften", "label": "Soften as it fades", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.5},
  {"key": "sensitivity", "label": "Cut sensitivity", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.5}
 ],
 "passes": [
  {"shader": "res://effects/_events/thumbs.gdshader", "scale": 0.125},
  {"shader": "res://effects/_events/stats_change.gdshader", "scale": 0.25},
  {"shader": "res://effects/_events/track_cut.gdshader", "scale": 1.0, "inputs": {"thumb_tex": 0}, "map": {"look_back": "linger"}},
  {"shader": "apply.gdshader", "scale": 32.0}
 ]
}
