  {"key": "depth", "label": "Pull back", "type": "float", "min": 0, "max": 2, "step": 0.01, "default": 0.25},
  {"key": "lens", "label": "Lens", "type": "float", "min": 10, "max": 90, "step": 1, "default": 45, "unit": " deg"},
