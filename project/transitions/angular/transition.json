{
 "id": "angular",
 "label": "Angular",
 "group": "Wipe",
 "space": "2D",
 "from": ["gl-transitions angular"],
 "blurb": "A hard edged sweep round the middle of the frame from a starting angle you choose, like the hand of a clock.",
 "default_duration": 1.0,
 "params": [
  {"key": "start_angle", "label": "Starts at", "type": "float", "min": 0, "max": 360, "step": 1, "default": 0, "unit": " deg"},
  {"key": "direction", "label": "Turns", "type": "enum", "choices": ["Counterclockwise", "Clockwise"], "default": 0},
  {"key": "softness", "label": "Soft edge", "type": "float", "min": 0, "max": 0.25, "step": 0.005, "default": 0},
  {"key": "curve", "label": "Timing", "type": "enum", "choices": ["Even", "Smooth"], "default": 0}
 ]
}
