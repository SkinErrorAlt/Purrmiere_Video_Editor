{
 "id": "water_drop",
 "label": "Water Drop",
 "group": "Distort",
 "space": "2D",
 "from": ["gl WaterDrop", "Keynote Droplet"],
 "blurb": "A drop lands on the picture and a ring of ripples spreads out from it, carrying the incoming picture with it and settling as it goes.",
 "default_duration": 1.2,
 "params": [
  {"key": "centre", "label": "Drop at", "type": "vec2", "default": [0.5, 0.5]},
  {"key": "waves", "label": "Ripples", "type": "float", "min": 2, "max": 60, "step": 0.5, "default": 16},
  {"key": "strength", "label": "Ripple height", "type": "float", "min": 0, "max": 80, "step": 1, "default": 18, "unit": " px"},
  {"key": "damping", "label": "Settling", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.5},
  {"key": "mode", "label": "Style", "type": "enum", "choices": ["Spreads in", "Dissolves"], "default": 0},
  {"key": "softness", "label": "Edge softness", "type": "float", "min": 0, "max": 0.3, "step": 0.005, "default": 0.03},
  {"key": "shine", "label": "Shine", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.3}
 ]
}
