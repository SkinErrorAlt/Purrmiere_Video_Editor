{
 "id": "gradient_wipe",
 "label": "Gradient Wipe",
 "group": "Wipe",
 "space": "2D",
 "from": ["Premiere Gradient Wipe", "gl-transitions luma"],
 "blurb": "The incoming picture spreads in following a greyscale map, dark parts of the map first and bright parts last. The map can be soft clouds, a straight or round gradient, or the brightness of either picture.",
 "default_duration": 1.2,
 "params": [
  {"key": "gradient", "label": "Map", "type": "enum", "choices": ["Clouds", "Linear", "Radial", "Outgoing brightness", "Incoming brightness"], "default": 0},
  {"key": "softness", "label": "Softness", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.1},
  {"key": "invert", "label": "Invert", "type": "bool", "default": false},
  {"key": "scale", "label": "Cloud size", "type": "float", "min": 0.5, "max": 12, "step": 0.1, "default": 3},
  {"key": "angle", "label": "Gradient angle", "type": "float", "min": -180, "max": 180, "step": 1, "default": 0, "unit": " deg"},
  {"key": "curve", "label": "Timing", "type": "enum", "choices": ["Even", "Smooth"], "default": 0}
 ]
}
