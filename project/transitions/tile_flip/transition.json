{
 "id": "tile_flip",
 "label": "Tile Flip",
 "group": "3D",
 "space": "3D",
 "from": ["Impress Tile Flip", "gl GridFlip"],
 "blurb": "The picture is cut into a grid of tiles that each flip over in turn, with the outgoing picture on their fronts and the incoming picture on their backs.",
 "default_duration": 1.6,
 "params": [
  {"key": "columns", "label": "Columns", "type": "int", "min": 2, "max": 24, "step": 1, "default": 6},
  {"key": "axis", "label": "Flips", "type": "enum", "choices": ["Sideways", "Up and over"], "default": 0},
  {"key": "pattern", "label": "Order", "type": "enum", "choices": ["Random", "Left to right", "Diagonal", "From the centre"], "default": 0},
  {"key": "flip_time", "label": "Flip length", "type": "float", "min": 0.15, "max": 1, "step": 0.01, "default": 0.45},
  {"key": "gap", "label": "Gap", "type": "float", "min": 0, "max": 0.4, "step": 0.01, "default": 0.1},
  {"key": "lens", "label": "Lens", "type": "float", "min": 10, "max": 90, "step": 1, "default": 40, "unit": " deg"},
  {"key": "shading", "label": "Shading", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.6},
  {"key": "background", "label": "Background", "type": "color", "default": [0, 0, 0, 1]}
 ]
}
