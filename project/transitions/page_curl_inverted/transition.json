  {"key": "radius", "label": "Curl size", "type": "float", "min": 0.02, "max": 0.5, "step": 0.01, "default": 0.15},
  {"key": "back_fade", "label": "Back of page", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.5},
  {"key": "paper", "label": "Paper colour", "type": "color", "default": [0.95, 0.94, 0.9, 1]},
  {"key": "shadow", "label": "Shadow", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.5},
  {"key": "lens", "label": "Lens", "type": "float", "min": 10, "max": 90, "step": 1, "default": 40, "unit": " deg"},
  {"key": "shading", "label": "Shading", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.6},
  {"key": "background", "label": "Background", "type": "color", "default": [0, 0, 0, 1]}
 ]
