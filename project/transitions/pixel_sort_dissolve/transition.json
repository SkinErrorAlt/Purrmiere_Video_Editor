  {"key": "high", "label": "Brightest sorted", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.9},
  {"key": "max_length", "label": "Longest streak", "type": "float", "min": 20, "max": 800, "step": 1, "default": 320, "unit": " px"},
  {"key": "mode", "label": "Mode", "type": "enum", "choices": ["Sort", "Stretch"], "default": 0},
  {"key": "curve", "label": "Timing", "type": "enum", "choices": ["Even", "Smooth"], "default": 1}
 ]
