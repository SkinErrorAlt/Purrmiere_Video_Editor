  {"key": "warp_amt", "label": "Billow", "type": "float", "min": 0.0, "max": 1.2, "step": 0.01, "default": 0.45},
  {"key": "feather", "label": "Softness", "type": "float", "min": 0.02, "max": 0.3, "step": 0.01, "default": 0.12},
  {"key": "fringe", "label": "Ink fringe", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.55},
