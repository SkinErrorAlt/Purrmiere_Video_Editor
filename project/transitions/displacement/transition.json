{
 "id": "displacement",
 "label": "Displace",
 "group": "Distort",
 "space": "2D",
 "from": ["gl displacement", "Sapphire Dissolve Distort", "After Effects Displacement Map"],
 "blurb": "A displacement map pushes the outgoing picture out of shape and pulls the incoming one in from the opposite way as they blend. The map can be cloudy noise or the brightness of either picture, so its shapes show in the warp, and it can push along one angle or drive across and up and down from two different maps.",
 "default_duration": 1.0,
 "params": [
  {"key": "strength", "label": "Push amount", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.5},
  {"key": "source", "label": "Map", "type": "enum", "choices": ["Noise", "Outgoing brightness", "Incoming brightness"], "default": 0},
  {"key": "axes", "label": "Directions", "type": "enum", "choices": ["Along an angle", "Across and up and down"], "default": 0},
  {"key": "angle", "label": "Push angle", "type": "float", "min": -180, "max": 180, "step": 1, "default": 0, "unit": " deg"},
  {"key": "source_y", "label": "Up and down map", "type": "enum", "choices": ["Noise", "Outgoing brightness", "Incoming brightness"], "default": 2},
  {"key": "strength_y", "label": "Up and down push", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.5},
  {"key": "scale", "label": "Noise cells across", "type": "float", "min": 0.5, "max": 20, "step": 0.1, "default": 3},
  {"key": "detail", "label": "Noise detail", "type": "int", "min": 1, "max": 5, "step": 1, "default": 3},
  {"key": "softness", "label": "Map softness", "type": "float", "min": 0, "max": 40, "step": 0.5, "default": 4, "unit": " px"},
  {"key": "curve", "label": "Timing", "type": "enum", "choices": ["Even", "Smooth"], "default": 0}
 ]
}
