  {"key": "softness", "label": "Edge softness", "type": "float", "min": 0, "max": 40, "step": 0.5, "default": 1.5, "unit": " px"},
  {"key": "rotation", "label": "Rotation", "type": "float", "min": -180, "max": 180, "step": 1, "default": 0, "unit": " deg"},
  {"key": "twist", "label": "Turn while opening", "type": "float", "min": -1, "max": 1, "step": 0.01, "default": 0},
  {"key": "centre", "label": "Centre", "type": "vec2", "default": [0.5, 0.5]}
