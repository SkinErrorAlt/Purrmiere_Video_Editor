{
 "id": "stereo_viewer",
 "label": "Stereo Viewer",
 "group": "3D",
 "space": "2D",
 "from": ["gl StereoViewer"],
 "blurb": "Like the reel of a toy stereo viewer: the outgoing picture shrinks into a frame with rounded corners, the reel turns to bring the incoming frame round, and it grows back to fill the screen.",
 "default_duration": 1.4,
 "params": [
  {"key": "direction", "label": "Reel turns", "type": "enum", "choices": ["Left", "Right"], "default": 0},
  {"key": "zoom", "label": "Frame size", "type": "float", "min": 0.4, "max": 1, "step": 0.01, "default": 0.84},
  {"key": "corner_radius", "label": "Corner radius", "type": "float", "min": 0, "max": 0.5, "step": 0.01, "default": 0.18},
  {"key": "reel", "label": "Reel size", "type": "float", "min": 1, "max": 4, "step": 0.01, "default": 2.4},
  {"key": "gap", "label": "Gap", "type": "float", "min": 0, "max": 0.5, "step": 0.01, "default": 0.12},
  {"key": "shadow", "label": "Shadow", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.5},
  {"key": "background", "label": "Background", "type": "color", "default": [0, 0, 0, 1]}
 ]
}
